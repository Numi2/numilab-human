+def separation_axes(left, right):
+    """Select the strongest separating projection in the unchanged pose."""
+    e1 = np.roll(left, -1, axis=1) - left
+    e2 = np.roll(right, -1, axis=1) - right
+    n1 = np.cross(e1[:, 0], e1[:, 1])
+    n2 = np.cross(e2[:, 0], e2[:, 1])
+    ee = np.cross(e1[:, :, None], e2[:, None, :]).reshape(-1, 9, 3)
+    axes = np.concatenate((n1[:, None], n2[:, None], ee,
+                           np.cross(n1[:, None], e1), np.cross(n2[:, None], e2)), axis=1)
+    length = np.linalg.norm(axes, axis=-1)
+    axes /= np.maximum(length[..., None], 1.e-30)
+    axes = np.concatenate((axes, -axes), axis=1)
+    origin = left[:, :1]
+    project_left = np.einsum("pvi,pai->pva", left - origin, axes)
+    project_right = np.einsum("pvi,pai->pva", right - origin, axes)
+    gaps = project_right.min(axis=1) - project_left.max(axis=1)
+    gaps[np.concatenate((length, length), axis=1) <= 1.e-14] = -np.inf
+    choices = gaps.argmax(axis=1)
+    assert np.isfinite(gaps[np.arange(len(choices)), choices]).all()
+    return axes[np.arange(len(choices)), choices]
+
+
+def contact_constraints(points, faces, jacobian, groups, columns, witnesses):
+    """Keep newly colliding triangle pairs within their certified rest halfspace."""
+    ids = np.asarray(sorted(witnesses), dtype=int).reshape(-1, 2)
+    left_ids, right_ids = np.moveaxis(faces[ids], 1, 0)
+    u, v = points[left_ids].astype(float) * 1000., points[right_ids].astype(float) * 1000.
+    axis = separation_axes(u, v)
+    gap = np.einsum("pijd,pd->pij", v[:,None] - u[:,:,None], axis)
+    margin = np.clip(.25 * gap.min(axis=(1,2)), 0., .025)
+    # New exact intersections may be associated with nearly coplanar Float32
+    # triangles. For a negative rest slack leave the original slack unchanged.
