+def neighbor_constraints(points, jacobian, groups, columns, left_ids, right_points):
+    """Protect exact neighboring witness triangles in the same frozen pose."""
+    u = points[left_ids].astype(float) * 1000.
+    v = right_points.astype(float) * 1000.
+    axis = separation_axes(u, v)
+    gap = np.einsum("pijd,pd->pij", v[:,None] - u[:,:,None], axis)
+    nearest = gap.min(axis=(1, 2))
+    margin = np.clip(.25 * nearest, 0., .025)
+    rhs = (np.minimum(nearest, 0.) + margin)[:,None,None] - gap
+    coefficients = np.einsum("pi,pvij->pvj", axis, jacobian[left_ids])
+    coefficients = np.broadcast_to(coefficients[:,:,None,:], (*rhs.shape,3)).ravel()
+    indices = (3 * columns[groups[left_ids]][:,:,None] + np.arange(3))
+    indices = np.broadcast_to(indices[:,:,None,:], (*rhs.shape,3)).ravel()
+    keep = indices >= 0
+    rows = np.repeat(np.arange(rhs.size), 3)
+    return sparse.coo_matrix((coefficients[keep],(rows[keep],indices[keep])),
+        shape=(rhs.size,3*np.count_nonzero(columns >= 0))).tocsr(), rhs.ravel()
+
+
