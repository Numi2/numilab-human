+def orientation_constraints(points, faces, group, columns, jacobian=None):
+    """Linearize projected face areas with respect to the source displacement."""
+    local = columns[group[faces]]
+    keep = np.any(local >= 0, axis=1)
+    rows = local[keep]
+    triangle = points[faces[keep]].astype(float) * 1000.
+    e1 = triangle[:, 1] - triangle[:, 0]
+    e2 = triangle[:, 2] - triangle[:, 0]
+    n = np.cross(e1, e2)
+    denominator = np.einsum("ij,ij->i", n, n)
+    usable = denominator > 0.
+    d1 = np.cross(e2[usable], n[usable]) / denominator[usable, None]
+    d2 = np.cross(n[usable], e1[usable]) / denominator[usable, None]
+    coefficients = np.stack((-d1-d2, d1, d2), axis=1)
+    if jacobian is not None:
+        coefficients = np.einsum("rvi,rvij->rvj", coefficients, jacobian[faces[keep][usable]])
+    rows = rows[usable]
+    indices = (3 * rows[:, :, None] + np.arange(3)).ravel()
+    nonzero = indices >= 0
+    row = np.repeat(np.arange(len(rows)), 9)
+    return sparse.coo_matrix((coefficients.ravel()[nonzero],
+                              (row[nonzero], indices[nonzero])),
+                             shape=(len(rows), 3*np.count_nonzero(columns >= 0))).tocsr()
