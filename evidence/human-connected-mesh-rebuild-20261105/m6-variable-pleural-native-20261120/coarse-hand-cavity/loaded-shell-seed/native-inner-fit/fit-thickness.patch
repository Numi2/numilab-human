+def largest_admitted_move(rest, world, node, n, delta, thickness):
+    """Keep the candidate inside its existing skin/fat thickness interval."""
+    neighbors = np.array((node - n, node + n))
+    frames = (rest, world)
+    minimum, maximum = thickness.T
+
+    def admissible(scale):
+        for points in frames:
+            lengths = np.linalg.norm(points[node] + scale * delta - points[neighbors], axis=1)
+            if np.any(lengths <= minimum + 2.e-7) or np.any(lengths >= maximum - 2.e-7):
+                return False
+        return True
+
+    if admissible(1.):
+        return delta
+    assert admissible(0.)
+    lower, upper = 0., 1.
+    for _ in range(40):
+        trial = (lower + upper) * .5
+        if admissible(trial):
+            lower = trial
+        else:
+            upper = trial
+    return lower * delta
+
+
+def fit_node(rest, world, loaded, tets, rows, labels, node, witness, limits, expand, n, thickness):
