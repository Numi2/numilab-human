+inline std::pair<const inferred_acl::BoneSurface*,inferred_acl::detail::Projection> materialPoint(
+ std::span<const inferred_acl::BoneSurface> surfaces,std::uint32_t body,std::uint32_t stable,
+ const MaterialAttachment& attachment){
+ using namespace inferred_acl::detail;
+ const inferred_acl::BoneSurface* surface=nullptr;
+ for(const auto& candidate:surfaces){
+  if(candidate.body!=body||candidate.stableId!=stable)continue;
+  if(surface)throw std::runtime_error("ligament material attachment surface is ambiguous");
+  surface=&candidate;
+ }
+ if(!surface||stable==0||surface->sourceRecord==MR_INVALID_INDEX||
+    surface->payloadSha256!=kReferenceBonesPayloadSha256)
+  throw std::runtime_error("ligament material attachment source identity is invalid");
+ const auto& s=*surface;
+ const std::uint64_t base=3ull*attachment.triangle;
+ if(s.triangleIndices.size()%3!=0||base+2>=s.triangleIndices.size()||
+    s.worldNormals.size()!=s.worldVertices.size())
+  throw std::runtime_error("ligament material attachment triangle is invalid");
+ const V3& weights=attachment.barycentric;
+ double sum=0;
+ V3 p{},n{};
+ for(std::size_t i=0;i<3;++i){
+  const auto vertex=s.triangleIndices[base+i];
+  const double weight=weights[i];
+  if(vertex>=s.worldVertices.size()||!std::isfinite(weight)||weight<=0.0||weight>=1.0)
+   throw std::runtime_error("ligament material attachment vertex or weight is invalid");
+  p=add(p,mul(s.worldVertices[vertex],weight));
+  n=add(n,mul(s.worldNormals[vertex],weight));
+  sum+=weight;
+ }
+ if(std::abs(sum-1.0)>1e-12||!std::isfinite(norm(p)))
+  throw std::runtime_error("ligament material attachment coordinates are invalid");
+ return {surface,{p,unit(n,"ligament material attachment normal is invalid"),attachment.triangle,0.0}};
+}
