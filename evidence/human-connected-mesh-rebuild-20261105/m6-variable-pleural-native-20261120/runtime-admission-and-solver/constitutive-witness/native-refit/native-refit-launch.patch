+def restore_if_compacted(path, expected):
+    if path.is_file():
+        return
+    archive = Path(str(path)+".zst")
+    temporary = Path(str(path)+".incomplete")
+    subprocess.run(["/opt/homebrew/bin/zstd", "-qd", str(archive), "-o", str(temporary)],
+                   check=True)
+    if digest(temporary) != expected:
+        temporary.unlink()
+        raise ValueError(f"Restored backing file does not match its receipt: {path}")
+    temporary.rename(path)
