+// The current-geometry importer has already verified these files. Use
+// their live hashes to bind the two solver-free role replay receipts.
+// The assembly owner still reconstructs and certifies the full paired flow.
+inline bool bindDirectRoleReplay(CurrentFractionalRecordedFlowBinding& binding,
+        const ConservativeSpatialMassTransportInput& input,std::string& error) {
+    constexpr std::string_view prefix="NUMI_HUMAN_PHYSICAL_SKIN_REGISTERED_VOLUME_PREFLIGHT_";
+    std::string nodes,elements,labels;
+    if(!envSHA(std::string(prefix)+"TETGEN_NODE_SHA256",nodes,error)||
+       !envSHA(std::string(prefix)+"TETGEN_ELEMENTS_SHA256",elements,error)||
+       !envSHA(std::string(prefix)+"CHILD_LABELS_SHA256",labels,error))return false;
+    if(input.maximumTransportDistanceM!=binding.transportDistanceLimitM||
+       labels!=input.regionLabelSHA256||!validSHA256(input.childMeshSHA256)||
+       !validSHA256(input.coordinateFrameSHA256)||!validSHA256(input.parentMassPacketSHA256)||
+       !validSHA256(input.parentSourceContributionSHA256)||!validSHA256(binding.source330LabelSHA256)) {
+        error="direct recorded role replay is detached from the pinned native volume, parent, or distance limit";
+        return false;
+    }
+    for(std::size_t role=0;role<binding.roleAssets.size();++role) {
+        binding.roleAssets[role].expectedInputSHA256={
+            std::string(input.parentMassPacketSHA256),std::string(input.parentSourceContributionSHA256),
+            std::string(input.childMeshSHA256),labels,std::string(input.coordinateFrameSHA256),
+            nodes,elements,labels,binding.roleP1SHA256[role],binding.roleCarrierPacketSHA256[role]};
+    }
+    binding.candidateParentRows=input.parentMassKg.size();
+    binding.candidateChildRows=input.childMaterialIndices.size();
+    return true;
 }
