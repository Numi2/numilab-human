+inline bool closedBoneContainsSpan(V3 a,V3 b,const inferred_acl::BoneSurface& mesh) {
+ using namespace inferred_acl::detail;
+ if(mesh.worldVertices.empty())return false;
+ const V3 p=mul(add(a,b),.5);
+ V3 lo=mesh.worldVertices.front(),hi=lo;
+ for(const auto& v:mesh.worldVertices)for(unsigned j=0;j<3;++j){
+  lo[j]=std::min(lo[j],v[j]);hi[j]=std::max(hi[j],v[j]);
+ }
+ for(unsigned j=0;j<3;++j)if(p[j]<lo[j]||p[j]>hi[j])return false;
+ // Open bones retain their surface-intersection certificate. Only a closed,
+ // consistently oriented bank can supply a signed solid-angle certificate.
+ if(!orientedClosed(mesh))return false;
+ double halfAngle=0;
+ const auto& ids=mesh.triangleIndices;
+ for(std::size_t i=0;i<ids.size();i+=3){
+  const V3 u=sub(mesh.worldVertices[ids[i]],p),v=sub(mesh.worldVertices[ids[i+1]],p),
+           w=sub(mesh.worldVertices[ids[i+2]],p);
+  const double lu=norm(u),lv=norm(v),lw=norm(w);
+  if(lu==0||lv==0||lw==0)return true;
+  const double num=dot(u,cross(v,w));
+  const double den=lu*lv*lw+dot(u,v)*lw+dot(v,w)*lu+dot(w,u)*lv;
+  // Coplanarity alone does not put p on the triangle. The denominator
+  // distinguishes its interior and boundary from the exterior plane.
+  if(num==0 && den<=0)return true;
+  halfAngle+=std::atan2(num,den);
+ }
+ if(!std::isfinite(halfAngle))throw std::runtime_error("nonfinite closed-bone winding");
+ return std::abs(halfAngle)>std::acos(-1.0);
 }
