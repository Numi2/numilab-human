+// A crossing-free open span can still lie entirely in a bone. Exact coordinate
+// welding restores source seams only for the oriented closure test.
+inline bool orientedClosed(const inferred_acl::BoneSurface& mesh) {
+ const auto& vertices=mesh.worldVertices;
+ const auto& indices=mesh.triangleIndices;
+ if(indices.size()<12 || indices.size()%3!=0)return false;
+ std::vector<V3> unique(vertices.begin(),vertices.end());
+ std::sort(unique.begin(),unique.end());
+ unique.erase(std::unique(unique.begin(),unique.end()),unique.end());
+ std::vector<std::size_t> id;
+ id.reserve(vertices.size());
+ for(const auto& p:vertices)
+  id.push_back(std::lower_bound(unique.begin(),unique.end(),p)-unique.begin());
+ struct Edge {std::size_t lo,hi;bool forward;};
+ std::vector<Edge> edges;
+ edges.reserve(indices.size());
+ for(std::size_t t=0;t<indices.size();t+=3){
+  for(std::size_t j=0;j<3;++j){
+   const auto a=id.at(indices[t+j]),b=id.at(indices[t+(j+1)%3]);
+   if(a==b)return false;
+   edges.push_back({std::min(a,b),std::max(a,b),a<b});
+  }
+ }
+ std::sort(edges.begin(),edges.end(),[](const Edge& a,const Edge& b){
+  return a.lo==b.lo?a.hi<b.hi:a.lo<b.lo;
+ });
+ for(std::size_t i=0;i<edges.size();i+=2){
+  if(i+1>=edges.size())return false;
+  const auto& a=edges[i]; const auto& b=edges[i+1];
+  if(a.lo!=b.lo||a.hi!=b.hi||a.forward==b.forward)return false;
+  if(i+2<edges.size()&&a.lo==edges[i+2].lo&&a.hi==edges[i+2].hi)return false;
+ }
+ return true;
+}
