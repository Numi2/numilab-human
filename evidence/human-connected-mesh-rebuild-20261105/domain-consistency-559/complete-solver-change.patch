+// The separated nonlinear latch owns whether a physical domain is held.
+// Below the legacy aggregate tolerance it can still request a correction;
+// such a solve must meet its chosen forcing target rather than completing
+// solely at that obsolete bound. Keep non-domain legacy policy unchanged.
+inline bool fgmresActiveRHSRequiresForcingTarget(
+    const uint layoutFlags,
+    const uint replaceResidual,
+    const float nonlinearConverged,
+    const float initialNorm,
+    const float legacyNonlinearThreshold
+) {
+    return (layoutFlags & 2u) != 0u
+        ? !(nonlinearConverged > 0.5f)
+        : ((replaceResidual & 2u) != 0u &&
+           initialNorm > legacyNonlinearThreshold);
 }
 
