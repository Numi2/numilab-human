+    const uint replaceResidual,
+    const float nonlinearConverged,
+    const float initialNorm,
+    const float legacyNonlinearThreshold
+) {
+    return (layoutFlags & 2u) != 0u
+        ? !(nonlinearConverged > 0.5f)
+        : ((replaceResidual & 2u) != 0u &&
+           initialNorm > legacyNonlinearThreshold);
+}
