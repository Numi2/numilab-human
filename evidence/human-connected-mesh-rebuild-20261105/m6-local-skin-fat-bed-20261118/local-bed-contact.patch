+    const char* value = std::getenv("NUMI_HUMAN_LOCAL_BED_LAYERS");
+    require(!value || std::strcmp(value, "0") == 0 || std::strcmp(value, "1") == 0,
+            "NUMI_HUMAN_LOCAL_BED_LAYERS must be 0 or 1");
+    return value && std::strcmp(value, "1") == 0;
+}
