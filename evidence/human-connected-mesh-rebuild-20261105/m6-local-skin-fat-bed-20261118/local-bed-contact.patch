+// In the global fixed-plane mode these lanes hold normal tissue compliance
+// (m/N) and Kelvin–Voigt retardation time (s). A per-contact plane still
+// requires both reserved lanes to be zero. Zero preserves the rigid solver.
+struct StandContactNormalLaw {
+    float targetVelocity;
+    float inverseMass;
+};
+
+inline StandContactNormalLaw standContactNormalLaw(
+    const MRNumiHumanStandContactGPU support, const float gap, const float dt
+) {
+    const float compliance = support.planePoint.w;
+    if (compliance == 0.0f)
+        return {mrNumiHumanContactVelocityTarget(gap, dt,
+            support.frictionSlopAndStabilization.z,
+            support.boundaryNormalVelocity), 0.0f};
+
+    // F = k * (-(g + dt*v)) - b*v when the layer is already compressed.
+    // Exclude dashpot load before first touch. With lambda = dt*F, the
+    // projected row is v + inverseMass*lambda >= targetVelocity.
+    const float interval = dt + (gap < 0.0f ? support.planeNormal.w : 0.0f);
+    return {support.boundaryNormalVelocity - gap / interval,
+            compliance / (dt * interval)};
+}
