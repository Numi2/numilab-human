+// Activation-band ambiguity must not discard a force-bearing feature. When a
+// reference edge sweep is uncertified at activation thickness, retain an
+// endpoint potential ONLY after proving the entire original compensated sweep
+// above the unchanged numerical collision margin. The ordinary IPC evaluator
+// still computes its actual endpoint energy/force with the original width.
+inline bool nmReferenceNarrowphaseEndpointEdgePotential(
+    uint4 sources,thread const MRCompensatedPositionGPU* finishExpansion,
+    thread const float3* velocity,float leftDt,float rightDt,float clearance,
+    thread float3& normal,thread float2& parameters,
+    thread float3& point,thread float& separation) {
+    if(!(clearance>0.0f)||!isfinite(clearance)||
+       !nmReferenceNarrowphaseSeparated(NM_DEFORMABLE_CONTACT_EDGE_EDGE,sources,
+           finishExpansion,velocity,leftDt,rightDt,clearance))return false;
+    float u,v;float3 first,second;MRCompensatedPositionGPU relative;
+    if(!contactCompensatedSegmentWitness(finishExpansion[sources.x],
+            finishExpansion[sources.y],finishExpansion[sources.z],
+            finishExpansion[sources.w],u,v,first,second,relative,separation)||
+       !(separation>clearance)||!isfinite(separation)||
+       u<0.0f||u>1.0f||v<0.0f||v>1.0f)return false;
+    normal=(relative.high.xyz+relative.low.xyz)/separation;
+    parameters=float2(u,v);point=0.5f*(first+second);
+    return finite3(normal)&&finite3(point);
+}
