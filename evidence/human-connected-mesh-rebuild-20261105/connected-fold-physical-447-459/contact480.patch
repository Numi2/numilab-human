+kernel void nm_contact_reference_endpoint_potential_check(
+    device const MRCompensatedPositionGPU* positions [[buffer(0)]],
+    device const float4* parameters [[buffer(1)]],
+    device float4* results [[buffer(2)]],
+    constant uint& count [[buffer(3)]],uint index [[thread_position_in_grid]]) {
+    if(index>=count)return;
+    MRCompensatedPositionGPU finish[6];float3 velocity[6];
+    for(uint i=0u;i<6u;++i){finish[i]=mrCompensatedVector(float4(0.0f));velocity[i]=float3(0.0f);}
+    const uint4 sources=uint4(0u,1u,3u,4u);
+    for(uint i=0u;i<4u;++i){
+        finish[sources[i]]=positions[8u*index+4u+i];
+        const auto delta=mrCompensatedVectorAdd(finish[sources[i]],mrCompensatedVectorNegate(positions[8u*index+i]));
+        velocity[sources[i]]=delta.high.xyz+delta.low.xyz;
+    }
+    float3 normal,point;float2 uv;float separation;
+    const bool valid=nmReferenceNarrowphaseEndpointEdgePotential(sources,finish,
+        velocity,1.0f,1.0f,parameters[index].x,normal,uv,point,separation);
+    results[index]=valid?float4(separation,uv,length(normal)):float4(-1.0f);
+}
