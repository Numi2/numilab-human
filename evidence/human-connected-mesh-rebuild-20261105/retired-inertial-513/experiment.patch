+// First-Newton linear guess only. Globalization owns candidate kinematics,
+// contact and material feasibility. Common admission recomputes b-A*x0 using
+// the current operator, with both physical and scaled residual checks.
+kernel void nm_fgmres_accepted_inertial_guess(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMMicrostepGPU& microstep [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMIncidenceRangeGPU* nodeRanges [[buffer(3)]],
+    device const NMSchedulerStateGPU* schedulers [[buffer(4)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(5)]],
+    device const NMFEMNodeStateGPU* accepted [[buffer(6)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(7)]],
+    device float4* initialGuess [[buffer(8)]],
+    device float4* coefficients [[buffer(9)]],
+    device const NMMatterStatusGPU* statuses [[buffer(10)]],
+    uint global [[thread_position_in_grid]]) {
+    const uint total = dispatch.environmentCount * dispatch.femNodeCount;
+    if (global >= total || dispatch.femNodeCount == 0u) return;
+    const uint environment = global / dispatch.femNodeCount;
+    const bool healthy = environmentHealthy(statuses, environment);
+    if (global % dispatch.femNodeCount == 0u)
+        coefficients[environment] = float4(1.0f, 0.0f, healthy ? 1.0f : 0.0f, 1.0f);
+    float3 guess(0.0f);
+    const uint objectIndex = nodeRanges[global].objectIndex;
+    if (healthy && objectIndex < dispatch.objectCount &&
+        candidate[global].restAndFixed.w <= 0.5f) {
+        const NMContinuumObjectGPU object = objects[objectIndex];
+        const uint objectGlobal = environment * dispatch.objectCount + objectIndex;
+        const NMSchedulerStateGPU scheduler = schedulers[objectGlobal];
+        if (object.representation == NM_REPRESENTATION_FEM &&
+            objectDue(object, scheduler, adaptive[objectGlobal], microstep)) {
+            guess = accepted[global].velocityAndInverseMass.xyz +
+                objectTimestep(dispatch, scheduler) * dispatch.gravityAndTimestep.xyz -
+                candidate[global].velocityAndInverseMass.xyz;
+        }
+    }
+    // Pressure and all other domains retain their common cleared zero.
+    initialGuess[global] = float4(guess, 0.0f);
+}
