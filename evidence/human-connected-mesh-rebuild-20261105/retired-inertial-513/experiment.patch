+void checkAcceptedInertialGuess(id<MTLDevice> device,
+    id<MTLCommandQueue> queue, id<MTLLibrary> library) {
+    const auto seed = pipeline(device, library,
+        "numi_matter_metal::nm_fgmres_accepted_inertial_guess");
+    NMMatterDispatchGPU d{};
+    d.environmentCount = 2u; d.femNodeCount = 9u; d.objectCount = 2u;
+    d.maximumRateExponent = 1u;
+    d.gravityAndTimestep = {0.0f, -9.81f, 0.0f, 0.002f};
+    NMMicrostepGPU m{};
+    std::vector<NMContinuumObjectGPU> objects(2u);
+    objects[0].representation = NM_REPRESENTATION_FEM;
+    objects[1].representation = NM_REPRESENTATION_MPM;
+    objects[0].solver.y = 1u;
+    objects[0].flags = NM_OBJECT_ACTIVE;
+    std::vector<NMSchedulerStateGPU> schedulers(4u);
+    std::vector<NMAdaptiveStateGPU> adaptive(4u);
+    for (auto& v : schedulers) {v.activeExponent = 1u;v.numerical.w=1.0f;}
+    for (auto& v : adaptive) v.activeRepresentation=NM_REPRESENTATION_FEM;
+    std::vector<NMFEMNodeStateGPU> accepted(18u), candidate(18u);
+    std::vector<NMIncidenceRangeGPU> ranges(18u);
+    for (unsigned i = 0u; i < 18u; ++i) {
+        accepted[i].velocityAndInverseMass = {0.25f, -0.5f, 0.75f, 1.0f};
+        candidate[i].velocityAndInverseMass = {0.05f, -0.1f, 0.15f, 1.0f};
+        ranges[i].objectIndex = 0u;
+        candidate[i].restAndFixed.w = float(i % 9u <= 3u ? i % 9u : 0u);
+        if (i % 9u == 4u) ranges[i].objectIndex = NM_INVALID_INDEX;
+        if (i % 9u == 5u) ranges[i].objectIndex = 1u;
+    }
+    std::vector<NMMatterStatusGPU> statuses(2u);
+    statuses[1].code = 1u;
+    const nm_float4 sentinel{81.0f, -83.0f, 89.0f, -97.0f};
+    auto db=makeBuffer(device,std::vector{d}), mb=makeBuffer(device,std::vector{m});
+    auto ob=makeBuffer(device,objects), rb=makeBuffer(device,ranges);
+    auto sb=makeBuffer(device,schedulers), ab=makeBuffer(device,adaptive);
+    auto acceptedBuffer=makeBuffer(device,accepted), cb=makeBuffer(device,candidate);
+    auto gb=makeBuffer(device,std::vector<nm_float4>(40u,sentinel));
+    auto coeff=makeBuffer(device,std::vector<nm_float4>(2u));
+    auto status=makeBuffer(device,statuses);
+    dispatch(device,queue,seed,{{0u,db},{1u,mb},{2u,ob},{3u,rb},{4u,sb},
+        {5u,ab},{6u,acceptedBuffer},{7u,cb},{8u,gb},{9u,coeff},{10u,status}},1u,32u);
+    const auto got=readBuffer<nm_float4>(gb,40u);
+    for (unsigned i=0u;i<18u;++i) {
+        const bool free=i<9u && (i%9u==0u || i%9u>=6u);
+        if (!(close(got[i].x,free?0.2f:0.0f) && close(got[i].y,free?-0.40981f:0.0f) && close(got[i].z,free?0.6f:0.0f)))
+            std::cerr << "inertial row="<<i<<" free="<<free<<" value="<<got[i].x<<","<<got[i].y<<","<<got[i].z<<","<<got[i].w<<"\n";
+        require(close(got[i].x,free?0.2f:0.0f) &&
+            close(got[i].y,free?-0.40981f:0.0f) &&
+            close(got[i].z,free?0.6f:0.0f) && got[i].w==0.0f,
+            "inertial seed changed constraints, due rows, gravity, or velocity correction");
+    }
+    for (unsigned i=18u;i<40u;++i)
+        require(std::memcmp(&got[i],&sentinel,sizeof(sentinel))==0,
+            "inertial seed touched non-FEM domain or capacity tail");
+    require(readBuffer<nm_float4>(coeff,2u)[0].z==1.0f &&
+        readBuffer<nm_float4>(coeff,2u)[1].z==0.0f,
+        "inertial seed did not mask unhealthy environment");
+    require(std::memcmp(acceptedBuffer.contents,accepted.data(),accepted.size()*sizeof(accepted[0]))==0 &&
+        std::memcmp(cb.contents,candidate.data(),candidate.size()*sizeof(candidate[0]))==0,
+        "linear seed modified physical accepted or candidate state");
+    // Off-schedule FEM rows must remain zero as well.
+    statuses[1].code=0u;
+    for(auto& v:schedulers)v.activeExponent=0u;
+    m.microtick=1u;
+    std::memcpy(status.contents,statuses.data(),statuses.size()*sizeof(statuses[0]));
+    std::memcpy(sb.contents,schedulers.data(),schedulers.size()*sizeof(schedulers[0]));
+    std::memcpy(mb.contents,&m,sizeof(m));
+    dispatch(device,queue,seed,{{0u,db},{1u,mb},{2u,ob},{3u,rb},{4u,sb},
+        {5u,ab},{6u,acceptedBuffer},{7u,cb},{8u,gb},{9u,coeff},{10u,status}},1u,32u);
+    for(const auto& v:readBuffer<nm_float4>(gb,18u))
+        require(v.x==0.0f && v.y==0.0f && v.z==0.0f && v.w==0.0f,
+            "inertial seed touched inactive schedule");
+    std::cout << "accepted_inertial_guess=passed constraints=all_tags inactive=passed "
+                 "physical_state_unchanged=true capacity_tail=passed\n";
+}
