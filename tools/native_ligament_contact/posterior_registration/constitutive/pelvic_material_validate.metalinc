struct PelvicNode {float4 p,f;uint4 role;};
inline float3 pelvicRotationIncrement(float4 q,float4 r,float3 v){
    if(dot(q,r)<0)q=-q;
    float4 dq=q-r;
    return 2.f*(cross(dq.xyz,cross(r.xyz,v)+r.w*v)+cross(q.xyz,cross(dq.xyz,v)+dq.w*v));
}
kernel void nm_pelvic_material_pose(constant uint4& dims [[buffer(0)]],device const PelvicNode* nodes [[buffer(1)]],
    device const float4* modes [[buffer(2)]],device const float* coord [[buffer(3)]],device const MRArticulatedBodyPoseGPU* poses [[buffer(4)]],
    device const float4* low [[buffer(5)]],device float4* positions [[buffer(6)]],device const float4* refs [[buffer(7)]],device const float4* refPose [[buffer(8)]],device float4* delta [[buffer(9)]],uint i [[thread_position_in_grid]]){
    if(i>=dims.y)return;const auto r=nodes[i];const uint pi=r.role.y-dims.x,fi=r.role.z-dims.x;
    const auto P=poses[pi],F=poses[fi];const float4 invP=float4(-P.orientation.xyz,P.orientation.w);
    uint fref=r.role.z==131?2u:4u;float3 a=refs[3*i].xyz,tail=refs[3*i+1].xyz,b=refs[3*i+2].xyz;
    float3 shift=((F.position.xyz-refPose[fref].xyz)-(P.position.xyz-refPose[0].xyz))+(low[fi].xyz-low[pi].xyz);
    float3 relative=shift+pelvicRotationIncrement(F.orientation,refPose[fref+1],b)
        -pelvicRotationIncrement(P.orientation,refPose[1],a);
    float3 materialDelta=r.f.w*restingRotate(invP,relative);
    if(dims.w)materialDelta+=modes[i].xyz;
    delta[i]=float4(materialDelta,0);positions[i]=float4(a+(tail+materialDelta),0);
}
kernel void nm_pelvic_material_validate(constant uint4& dims [[buffer(0)]],constant float4& law [[buffer(1)]],device const uint4* cells [[buffer(2)]],
    device const float4* inverse [[buffer(3)]],device const float4* x [[buffer(4)]],device float4* groups [[buffer(5)]],device const float4* materialStatus [[buffer(6)]],
    uint i [[thread_position_in_grid]],uint lane [[thread_index_in_threadgroup]],uint group [[threadgroup_position_in_grid]]){
    threadgroup float4 result[128];float4 r=float4(INFINITY,-INFINITY,0,0);
    if(i<dims.z)r=materialStatus[i];
    result[lane]=r;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){if(lane<n){result[lane].x=min(result[lane].x,result[lane+n].x);result[lane].yzw=max(result[lane].yzw,result[lane+n].yzw);}threadgroup_barrier(mem_flags::mem_threadgroup);}
    if(!lane)groups[group]=result[0];
}
kernel void nm_pelvic_material_admit(constant uint4& d [[buffer(0)]],device const float4* stats [[buffer(1)]],
   device const float4* groups [[buffer(2)]],device MRNumiHumanStandStatusGPU* status [[buffer(3)]],device float4* trace [[buffer(4)]],
   uint lane [[thread_index_in_threadgroup]]){
    threadgroup float4 summary[128];
    float4 r=float4(INFINITY,-INFINITY,0,0);
    for(uint i=lane;i<d.y;i+=128){r.x=min(r.x,groups[i].x);r.yzw=max(r.yzw,groups[i].yzw);}
    summary[lane]=r;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){if(lane<n){summary[lane].x=min(summary[lane].x,summary[lane+n].x);summary[lane].yzw=max(summary[lane].yzw,summary[lane+n].yzw);}threadgroup_barrier(mem_flags::mem_threadgroup);}
    if(!lane){
        r=summary[0];if(d.x<d.z)trace[d.x]=r;
        bool valid=all(isfinite(r))&&r.x>.2f&&r.y<5.f&&r.z<5e6f&&r.w<5e6f;
        for(uint s=0;s<2;++s)valid=valid&&all(isfinite(stats[s]))&&stats[s].x<5e-7f;
        if(!valid&&status[0].code==MR_NUMI_HUMAN_STAND_SUCCESS)status[0].code=MR_NUMI_HUMAN_STAND_EXTERNAL_PHYSICS_FAILED;
    }
}

kernel void nm_pelvic_material_publish(constant uint4& d [[buffer(0)]],
    device const MRNumiHumanStandStatusGPU* stand [[buffer(1)]],device const NMMatterStatusGPU* matter [[buffer(2)]],
    device const NMHumanRespirationState* resp [[buffer(3)]],device const MRArticulatedBodyPoseGPU* poses [[buffer(4)]],
    device const float4* low [[buffer(5)]],device const float4* nodes [[buffer(6)]],device const float* modal [[buffer(7)]],
    device float4* snapshot [[buffer(8)]],device const uint* slots [[buffer(9)]],device const float* loads [[buffer(10)]],device const float4* normals [[buffer(11)]],device uint* cache [[buffer(12)]],device const PelvicPoolSample* pool [[buffer(13)]],device const uint* feature [[buffer(14)]],device const float4* totalDelta [[buffer(15)]],uint i [[thread_position_in_grid]]){
    if(i>=d.y||stand[0].code!=MR_NUMI_HUMAN_STAND_SUCCESS||stand[0].completedSteps!=d.x+1||
        resp[0].status.x!=d.x||matter[0].code!=NM_STATUS_SUCCESS)return;
    if(i==0)snapshot[0]=float4(float(d.x+1),float(d.y),0,0);
    if(i<4){
        const uint bodies[4]={1,128,131,145};uint b=bodies[i]-d.z,p=128-d.z;
        snapshot[1+2*i]=float4((poses[b].position.xyz-poses[p].position.xyz)+(low[b].xyz-low[p].xyz),0);
        snapshot[2+2*i]=poses[b].orientation;
    }
    snapshot[9+d.y+i]=float4(modal[4*i],modal[4*i+1],modal[4*i+2],0);
    if(i==0)cache[0]=d.x+1;
    if(i<512){
        uint index=slots[i];cache[1+i]=loads[i]>0?index:UINT_MAX;uint base=9+2*d.y;
        snapshot[base+2*i]=float4(normals[i].xyz,loads[i]);
        snapshot[base+2*i+1]=float4(index==UINT_MAX?-1.f:float(index),0,0,0);
        if(index!=UINT_MAX&&index>=pelvicReverseStart){snapshot[base+1024+2*i]=pool[index].weights;snapshot[base+1025+2*i]=float4(pool[index].nodes);}
    }
    snapshot[9+i]=nodes[i];snapshot[9+2*d.y+2048+i]=totalDelta[i];
}

// The same accepted-step gate and the same Float32 coordinates as native contact.
kernel void nm_pelvic_capture_surfaces(constant uint4& d [[buffer(0)]],device const MRNumiHumanStandStatusGPU* stand [[buffer(1)]],
    device const NMMatterStatusGPU* matter [[buffer(2)]],device const NMHumanRespirationState* resp [[buffer(3)]],
    device const MRArticulatedBodyPoseGPU* poses [[buffer(4)]],device const float4* low [[buffer(5)]],
    device const PelvicPoolSample* pool [[buffer(6)]],device const float4* verts [[buffer(7)]],device float4* snapshot [[buffer(8)]],uint i [[thread_position_in_grid]]){
    if(stand[0].code!=MR_NUMI_HUMAN_STAND_SUCCESS || stand[0].completedSteps!=d.x+1 ||
       resp[0].status.x!=d.x || matter[0].code!=NM_STATUS_SUCCESS)return;
    if(i<d.y)snapshot[i]=verts[i];
    if(i<d.z){auto s=pool[pelvicReverseStart+i].contact;
        snapshot[d.y+i]=float4(pelvicCortexPoint(s,s.domain.x-d.w,s.domain.z-d.w,poses,low),0);}
}

// Integrate over the actual projected finite overlap. A P1 gap and each P1
// shape average are exactly their values at the polygon's area centroid.
struct PelvicFacetPair {uint4 id;float4 shape[3],uv[3],bonePoint[3],pelvisPoint[3],offset[3];uint4 nodes;};
inline float pelvicCross2(float2 a,float2 b){return a.x*b.y-a.y*b.x;}
inline uint pelvicClipTriangle(thread const float3* bary,thread float3* polygon,thread uint* edges){
    polygon[0]=float3(1,0,0);polygon[1]=float3(0,1,0);polygon[2]=float3(0,0,1);
    uint n=3;float3 next[8];uint nextEdges[8];edges[0]=6;edges[1]=5;edges[2]=3;
    for(uint axis=0;axis<3&&n;++axis){
        float3 mask=float3(bary[0][axis],bary[1][axis],bary[2][axis]);uint m=0;
        for(uint i=0;i<n;++i){
            float3 a=polygon[i],b=polygon[(i+1)%n];float ca=dot(a,mask),cb=dot(b,mask);
            if(ca>=0){if(m==8)return 9;nextEdges[m]=edges[i]|(ca==0?(8u<<axis):0u);next[m++]=a;}
            if((ca<0&&cb>0)||(ca>0&&cb<0)){if(m==8)return 9;nextEdges[m]=(edges[i]&edges[(i+1)%n])|(8u<<axis);next[m++]=mix(a,b,ca/(ca-cb));}
        }
        n=m;for(uint i=0;i<n;++i){polygon[i]=next[i];edges[i]=nextEdges[i];}
    }
    return n;
}
kernel void nm_pelvic_finite_surface(constant uint4& d [[buffer(0)]],device const PelvicFacetPair* pairs [[buffer(1)]],
    device const PelvicTriangle* triangles [[buffer(2)]],device const float4* delta [[buffer(3)]],
    device const MRArticulatedBodyPoseGPU* poses [[buffer(4)]],device const float4* low [[buffer(5)]],
    device const float4* reference [[buffer(6)]],device PelvicPoolSample* pool [[buffer(7)]],device float* gaps [[buffer(8)]],
    device const uint* needed [[buffer(9)]],uint i [[thread_position_in_grid]]){
    if(i>=d.y)return;const auto pair=pairs[i];if(d.z&&!needed[pair.id.z])return;
    const uint at=pelvicFiniteStart+pelvicFacetRows*i,pi=128-d.x,bi=pair.id.y-d.x;
    const auto P=poses[pi],B=poses[bi];float4 ip=float4(-P.orientation.xyz,P.orientation.w),ib=float4(-B.orientation.xyz,B.orientation.w);
    const auto t=triangles[pair.id.x];float3 normal=t.data[3].xyz,e=t.data[1].xyz-t.data[0].xyz,f=t.data[2].xyz-t.data[0].xyz;
    float3 k=cross(e,f);float k2=dot(k,k);uint rb=pair.id.y==128?0:(pair.id.y==131?2:(pair.id.y==145?4:6));
    float3 trans=((B.position.xyz-reference[rb].xyz)-(P.position.xyz-reference[0].xyz))+(low[bi].xyz-low[pi].xyz);
    float3 bary[3],z;float3 clip[8];
    for(uint j=0;j<3;++j){float3 movement=0;
        for(uint a=0;a<4;++a)movement+=pair.shape[j][a]*delta[pair.nodes[a]].xyz;
        float3 relativeMotion=pi==bi?float3(0):restingRotate(ip,trans+
            pelvicRotationIncrement(B.orientation,reference[rb+1],pair.bonePoint[j].xyz)-
            pelvicRotationIncrement(P.orientation,reference[1],pair.pelvisPoint[j].xyz));
        float3 displacement=pair.offset[j].xyz+movement-relativeMotion;
        float3 step=pi==bi?displacement:restingRotate(ib,restingRotate(P.orientation,displacement));
        float2 uv=pair.uv[j].xy+float2(dot(cross(step,f),k),dot(cross(e,step),k))/k2;
        bary[j]=float3(1.f-uv.x-uv.y,uv);z[j]=dot(step,normal);
    }
    uint edges[8];uint n=pelvicClipTriangle(bary,clip,edges);
    for(uint j=0;j<pelvicFacetRows;++j){gaps[at+j]=INFINITY;pool[at+j].weights=float4(0);}
    if(!all(isfinite(bary[0]))||!all(isfinite(bary[1]))||!all(isfinite(bary[2]))){gaps[at]=-INFINITY;return;}
    if(n>8||!all(isfinite(z))){gaps[at]=-INFINITY;gaps[at+1]=-INFINITY;return;}
    if(pelvicCross2(bary[1].yz-bary[0].yz,bary[2].yz-bary[0].yz)>=0)return;
    float3 centroid=0;float area=0;
    for(uint j=1;j+1<n;++j){
        float twice=abs(pelvicCross2(clip[j].yz-clip[0].yz,clip[j+1].yz-clip[0].yz));
        centroid+=twice*(clip[0]+clip[j]+clip[j+1]);area+=twice;
    }
    if(area==0)return;
    centroid/=3.f*area;
    for(uint j=0;j<=n;++j){
        uint slot=0;float3 w=centroid;
        if(j && pelvicFacetRows==2){
            slot=1;w=clip[j-1];
        }else if(j){
            uint mask=edges[j-1],m=mask&7u,b=(mask>>3)&7u;w=clip[j-1];
            if(popcount(m)==2)slot=1u+ctz(7u^m);
            else if(popcount(b)==2)slot=4u+ctz(7u^b);
            else if(popcount(m)==1&&popcount(b)==1)slot=7u+3u*ctz(m)+ctz(b);
            else {gaps[at]=-INFINITY;return;}
        }
        float gap=dot(w,z);
        if(gap<gaps[at+slot]){
            gaps[at+slot]=gap;
            pool[at+slot].weights=w.x*pair.shape[0]+w.y*pair.shape[1]+w.z*pair.shape[2];
        }
    }
}
