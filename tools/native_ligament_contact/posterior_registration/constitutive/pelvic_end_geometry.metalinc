#include "pelvic_crossing_predicates.metalinc"

struct PelvicSplitPoint {float3 h,l;};
inline int pelvicSplitExact(thread const PelvicSplitPoint* p){
    PelvicDyadic q[4][3][2];int origin=0;
    for(uint c=0;c<3;++c){
        int e=105;
        for(uint i=0;i<4;++i)for(uint t=0;t<2;++t){
            q[i][c][t]=pelvicDyadic(t?p[i].l[c]:p[i].h[c]);
            if(q[i][c][t].mantissa)e=min(e,q[i][c][t].exponent);
        }
        if(e==105)return 0;
        origin+=e;
    }
    int sum[53]={0},last=0;
    for(uint k=0;k<4;++k){
        uint a=k==1?3:0,b=k==2?3:1,c=k==3?3:2;int sign=k?-1:1;
        for(uint i=0;i<3;++i){
            uint j=(i+1)%3,h=(i+2)%3;
            for(uint bits=0;bits<8;++bits){
                uint s=bits&1,u=(bits>>1)&1,v=bits>>2;
                pelvicExactTerm(q[a][i][s],q[b][j][u],q[c][h][v],sign,origin,sum,last);
                pelvicExactTerm(q[a][i][s],q[b][h][u],q[c][j][v],-sign,origin,sum,last);
            }
        }
    }
    int carry=0;bool nonzero=false;
    for(int i=0;i<=last;++i){
        int v=sum[i]+carry;carry=v/65536-int(v%65536<0);nonzero|=v-65536*carry!=0;
    }
    return carry<0?-1:int(nonzero||carry>0);
}
inline int pelvicSplitOrient(PelvicSplitPoint a,PelvicSplitPoint b,PelvicSplitPoint c,PelvicSplitPoint d){
    float3 xh=a.h-d.h,yh=b.h-d.h,zh=c.h-d.h;
    float3 x=xh+(a.l-d.l),y=yh+(b.l-d.l),z=zh+(c.l-d.l);
    float v=dot(x,cross(y,z));
    float3 ax=abs(xh)+abs(a.l)+abs(d.l),ay=abs(yh)+abs(b.l)+abs(d.l),az=abs(zh)+abs(c.l)+abs(d.l);
    float bound=dot(ax,ay.yzx*az.zxy+ay.zxy*az.yzx);
    if(bound>1e-24f&&bound<1e24f&&abs(v)>1e-5f*bound)return v>0?1:-1;
    PelvicSplitPoint p[4]={a,b,c,d};return pelvicSplitExact(p);
}
inline bool pelvicSplitEdge(PelvicSplitPoint p,PelvicSplitPoint q,thread const PelvicSplitPoint* t){
    int a=pelvicSplitOrient(p,q,t[0],t[1]),b=pelvicSplitOrient(p,q,t[1],t[2]);
    if(a*b<0)return false;int c=pelvicSplitOrient(p,q,t[2],t[0]);return a*c>=0&&b*c>=0;
}
inline bool pelvicSplitCross(thread const PelvicSplitPoint* a,thread const PelvicSplitPoint* b){
    int3 pa,pb;
    for(uint i=0;i<3;++i)pa[i]=pelvicSplitOrient(b[0],b[1],b[2],a[i]);
    if(!pelvicStraddles(pa))return false;
    for(uint i=0;i<3;++i)pb[i]=pelvicSplitOrient(a[0],a[1],a[2],b[i]);
    if(!pelvicStraddles(pb))return false;
    for(uint i=0;i<3;++i){uint j=(i+1)%3;
        if(pa[i]!=pa[j]&&pa[i]*pa[j]<=0&&pelvicSplitEdge(a[i],a[j],b))return true;
        if(pb[i]!=pb[j]&&pb[i]*pb[j]<=0&&pelvicSplitEdge(b[i],b[j],a))return true;}
    return false;
}

inline uint4 pelvicJoinWitness(uint4 a,uint4 b){
    bool useB=b.y<a.y||(b.y==a.y&&b.z<a.z);
    return uint4(a.x+b.x,useB?b.y:a.y,useB?b.z:a.z,a.w|b.w);
}
kernel void nm_pelvic_crossing_groups(constant uint& count [[buffer(0)]],device const uint4* cortexFaces [[buffer(1)]],
    device const float4* cortex [[buffer(2)]],device const PelvicSurfaceFace* skinFaces [[buffer(3)]],
    device const float4* skin [[buffer(4)]],device const PelvicBounds* boxes [[buffer(5)]],
    device uint4* partial [[buffer(6)]],device const MRCompensatedPositionGPU* physical [[buffer(7)]],device const uint4* atlas [[buffer(8)]],device const PelvicFacetPair* ports [[buffer(9)]],device atomic_uint* live [[buffer(10)]],device const uint2* registered [[buffer(11)]],device atomic_uint* registryMetrics [[buffer(12)]],device uint2* queue [[buffer(13)]],uint i [[thread_position_in_grid]],uint lane [[thread_index_in_threadgroup]],
    uint g [[threadgroup_position_in_grid]]){
    uint4 hit=uint4(0,UINT_MAX,UINT_MAX,0);
    if(i<count){
        uint4 f=cortexFaces[i];
        float3 b[3]={cortex[f.x].xyz,cortex[f.y].xyz,cortex[f.z].xyz};
        if(!all(isfinite(b[0]))||!all(isfinite(b[1]))||!all(isfinite(b[2])))hit.w=1;
        float3 lo=min(b[0],min(b[1],b[2])),hi=max(b[0],max(b[1],b[2]));
        uint4 region=pelvicSurf[f.w];
        uint tree=2*pelvicLeaves*f.w,node=1;
        while(node){
            auto box=boxes[tree+node];
            if(all(box.hi.xyz>=lo)&&all(box.lo.xyz<=hi)){
                if(node<pelvicLeaves){node*=2;continue;}
                uint first=8*(node-pelvicLeaves);
                for(uint j=first;j<min(region.w,first+8);++j){
                    uint face=region.z+j;uint4 m=skinFaces[face].vertices;
                    float3 a[3]={skin[m.x].xyz,skin[m.y].xyz,skin[m.z].xyz};
                    bool emittedBounds=all(max(a[0],max(a[1],a[2]))>=lo)&&all(min(a[0],min(a[1],a[2]))<=hi);
                    bool crosses=emittedBounds&&pelvicCrosses(a,b);
                    if(pelvicPhysicalBoundary&&!crosses){
                        PelvicSplitPoint p[3],q[3];float3 lower=INFINITY,upper=-INFINITY;
                        for(uint k=0;k<3;++k){
                            auto v=physical[m[k]];
                            p[k]={v.high.xyz,v.low.xyz};q[k]={b[k],float3(0)};
                            lower=min(lower,nextafter(v.high.xyz,float3(-INFINITY)));
                            upper=max(upper,nextafter(v.high.xyz,float3(INFINITY)));
                        }
                        if(all(upper>=lo)&&all(lower<=hi))crosses=pelvicSplitCross(p,q);
                    }
                    if(crosses){
                        ++hit.x;hit.y=i;hit.z=min(hit.z,face);
                        if(pelvicMotionRegistry){pelvicEnqueueMissing(uint2(i,face),f.w,registered,registryMetrics,queue);}
                        else if(pelvicExtraPairs){
                            uint l=pelvicFixedPairs,end=l+pelvicExtraPairs,u=end;
                            while(l<u){
                                uint k=l+(u-l)/2,ci=atlas[k].w,mi=ports[k].id.w;
                                if(ci<i||(ci==i&&mi<face))l=k+1;else u=k;
                            }
                            if(l<end&&atlas[l].w==i&&ports[l].id.w==face)
                                atomic_store_explicit(live+l-pelvicFixedPairs,1u,memory_order_relaxed);
                        }
                    }
                }
            }
            while(node&1u)node>>=1;
            if(node)++node;
        }
    }
    threadgroup uint4 tile[128];tile[lane]=hit;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){
        if(lane<n)tile[lane]=pelvicJoinWitness(tile[lane],tile[lane+n]);
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if(!lane)partial[g]=tile[0];
}
kernel void nm_pelvic_crossing_admit(constant uint4& d [[buffer(0)]],device const uint4* partial [[buffer(1)]],
    device const float4* skin [[buffer(2)]],device MRNumiHumanStandStatusGPU* status [[buffer(3)]],
    device uint4* trace [[buffer(4)]],device const MRCompensatedPositionGPU* physical [[buffer(5)]],device const atomic_uint* registryMetrics [[buffer(6)]],uint lane [[thread_index_in_threadgroup]]){
    uint4 h=uint4(0,UINT_MAX,UINT_MAX,0);
    for(uint i=lane;i<d.y;i+=128)h=pelvicJoinWitness(h,partial[i]);
    for(uint i=lane;i<d.w;i+=128){
        if(!all(isfinite(skin[i].xyz)))h.w=1;
        if(pelvicPhysicalBoundary&&(!all(isfinite(physical[i].high.xyz))||!all(isfinite(physical[i].low.xyz))))h.w=1;
    }
    threadgroup uint4 group[128];group[lane]=h;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){
        if(lane<n)group[lane]=pelvicJoinWitness(group[lane],group[lane+n]);
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if(!lane){
        uint4 result=group[0];if(pelvicMotionRegistry && atomic_load_explicit(registryMetrics+2,memory_order_relaxed))result.w|=2u;if(d.x<d.z)trace[d.x]=result;
        if((result.x||result.w)&&status[0].code==MR_NUMI_HUMAN_STAND_SUCCESS)
            status[0].code=MR_NUMI_HUMAN_STAND_EXTERNAL_PHYSICS_FAILED;
    }
}

// Retain the worst signed query in each direction at a rejected endpoint.
// This observer receives the already measured field and never changes forces or status.
kernel void nm_pelvic_rejected_queries(constant uint4& d [[buffer(0)]],device const MRNumiHumanStandStatusGPU* status [[buffer(1)]],
    device const float* gaps [[buffer(2)]],device const PelvicPoolSample* pool [[buffer(3)]],device uint4* trace [[buffer(4)]],
    uint group [[threadgroup_position_in_grid]],uint lane [[thread_index_in_threadgroup]]){
    if(status[0].code==MR_NUMI_HUMAN_STAND_SUCCESS||d.x>=d.y||trace[group].w)return;
    uint kind=group%3,side=group/3;uint ends[4]={0,pelvicReverseStart,pelvicFiniteStart,d.z};
    float worst=INFINITY;uint id=UINT_MAX;
    for(uint i=ends[kind]+lane;i<ends[kind+1];i+=128){
        if((pool[i].contact.domain.y==145)!=bool(side))continue;
        float v=gaps[i];if(v<worst){id=i;worst=v;}
    }
    threadgroup uint index[128];threadgroup float value[128];
    index[lane]=id;value[lane]=worst;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){
        if(lane<n&&(value[lane+n]<value[lane]||(value[lane+n]==value[lane]&&index[lane+n]<index[lane]))){
            index[lane]=index[lane+n];value[lane]=value[lane+n];
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    if(!lane){uint i=index[0];trace[group]=uint4(i,as_type<uint>(value[0]),i<UINT_MAX?pool[i].contact.domain.z:0,d.x+1);}
}

// Permit nonlinear iteration to reopen a provisionally converged contact solve.
// The exact pass is encoded indirectly only when both bulk/pressure solves are ready.
kernel void nm_pelvic_request_surface_check(constant uint4& d [[buffer(0)]],device const uint* needed [[buffer(1)]],
    device uint* control [[buffer(2)]],uint i [[thread_position_in_grid]]){
    if(i)return;
    if(d.y){control[0]=0;control[5]=0;control[6]=0;}
    bool test=!control[0] && (d.z || (!needed[0] && !needed[1]));
    control[1]=test;control[2]=test?d.x:0;control[3]=1;control[4]=1;
    if(test)++control[5];
}
kernel void nm_pelvic_resume_surface_solve(constant uint4& d [[buffer(0)]],device uint* needed [[buffer(1)]],
    device uint* control [[buffer(2)]],device const uint4* partial [[buffer(3)]],
    device const uint4* cortexFaces [[buffer(4)]],uint lane [[thread_index_in_threadgroup]]){
    if(!control[1])return;
    uint flags=0;
    for(uint i=lane;i<d.x;i+=128){
        uint4 p=partial[i];
        if(p.w)flags|=3;
        else if(p.x)flags|=1u<<cortexFaces[p.y].w;
    }
    threadgroup uint r[128];r[lane]=flags;threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint n=64;n;n>>=1){if(lane<n)r[lane]|=r[lane+n];threadgroup_barrier(mem_flags::mem_threadgroup);}
    if(!lane){
        if(r[0]==0)control[0]=(!needed[0] && !needed[1]);
        else{++control[6];for(uint side=0;side<2;++side)if(r[0]&(1u<<side))needed[side]=1;}
    }
}

kernel void nm_pelvic_live_features(constant uint& seed [[buffer(0)]],device const uint* slots [[buffer(1)]],
    device const float* pressure [[buffer(2)]],device atomic_uint* live [[buffer(3)]],device PelvicPoolSample* pool [[buffer(4)]],device float* gaps [[buffer(5)]],uint i [[thread_position_in_grid]]){
    if(!seed){
        if(i<pelvicExtraPairs)atomic_store_explicit(live+i,0u,memory_order_relaxed);
        if(i<pelvicExtraPairs*pelvicFacetRows){
            uint k=pelvicFiniteStart+pelvicFixedPairs*pelvicFacetRows+i;
            gaps[k]=INFINITY;pool[k].weights=0;pool[k].contact.reference=0;
        }
        return;
    }
    if(i>=512 || !pelvicExtraPairs || pressure[i]<=0)return;
    uint first=pelvicFiniteStart+pelvicFixedPairs*pelvicFacetRows,k=slots[i];
    if(k>=first && k<first+pelvicExtraPairs*pelvicFacetRows)
        atomic_store_explicit(live+(k-first)/pelvicFacetRows,1u,memory_order_relaxed);
}
