#!/bin/bash
set -eu
here=$(dirname "$(realpath "$0")")
assembly=$(dirname "$here")
material=$(dirname "$assembly")
prior="$material/run-tissue-registration"
if [[ "${1:-}" == --help ]];then
    "$prior" --help
    echo 'Use --full-first-contact [new-output-directory] for 16 full-volume native steps of 15.625 microseconds each. This exercises contact at release. Supported rest remains unqualified.'
    echo 'Use --check-full-first-contact RUN to check the native terminal frame, registered skin and fat, and anatomical crossings. A failing frame returns a nonzero exit.'
    echo 'Use --registered-finger-motion [new-output-directory] for 16 seconds of supported native motion with experimentally registered distal finger extensor insertions.'
    exit
fi
if [[ "${1:-}" == --registered-finger-motion ]]; then
    shift
    [[ $# -le 1 ]] || { echo 'Expected at most one output directory' >&2; exit 2; }
    source_dir="$here/connected-digit-registration-064/supported-input"
    [[ -f "$source_dir/launch.json" ]] || { echo 'Missing installed registered tendon scene' >&2; exit 1; }
    runner_root="$here"
    while [[ "$runner_root" != / && !( -f "$runner_root/run_bed_work.py" && -f "$runner_root/patch-owner/identities.json" ) ]]; do
        runner_root=$(dirname "$runner_root")
    done
    [[ -f "$runner_root/patch-owner/identities.json" ]] || { echo 'Missing pinned native support owner' >&2; exit 1; }
    out=${1:-$(mktemp -d "$here/finger-motion.XXXXXX")/run}
    export NUMI_RETAIN_SUPPORT_GEOMETRY=1
    exec /Users/numi/numi-human-prep-venv-20261005/bin/python3 "$runner_root/run_bed_work.py" \
        "$source_dir" "$runner_root/patch-owner" "$out" 8000 --no-bed-work-audit --intermediate-steps 3999
fi
if [[ "${1:-}" == --check-full-first-contact ]]; then
    [[ $# == 2 && -f "$2/execution.json" ]] || { echo 'Expected a completed first-contact run directory' >&2; exit 2; }
    prep="$assembly/full-tissue-release"
    tools=$(dirname "$(cat "$prep/audit.path")")
    predicate=$(cat "$prep/predicate.path")
    sources="$here"
    at="$here"
    while [[ "$at" != / && ! -f "$at/resting-surface-clearance-001/audit.py" ]]; do
        if [[ -f "$at/fit_posterior_equilibrium.py" || -f "$at/material_context.py" ||
              -f "$at/run_cavity_motion.py" || -f "$at/torso_cell_geometry.py" ]]; then
            sources="$sources:$at"
        fi
        if [[ -f "$at/capsule-material-contact-042/recovery-checkout/src/numilab_human/capsular_material_registration.py" ]]; then
            sources="$sources:$at/capsule-material-contact-042/recovery-checkout/src"
        fi
        at=$(dirname "$at")
    done
    reader="$at/resting-surface-clearance-001/audit.py"
    [[ -f "$reader" && -f "$predicate" ]] || { echo 'Missing registered boundary predicate or replay reader' >&2; exit 1; }
    export PYTHONPATH="$sources:$tools:$(dirname "$predicate")"
    exec /Users/numi/numi-human-prep-venv-20261005/bin/python3 "$here/verify_first_touch.py" "$2" "$tools" "$reader" "$predicate"
fi
if [[ "${1:-}" != --full-first-contact ]];then exec "$prior" "$@";fi
shift
[[ $# -le 1 ]] || { echo 'Expected at most one output directory' >&2;exit 2; }
out=${1:-$(mktemp -d "$here/full-contact.XXXXXX")/run}
# Locate the existing native process watchdog in the installed preparation tree.
runtime="$here"
while [[ "$runtime" != / && ! -f "$runtime/run_cavity_motion.py" ]];do runtime=$(dirname "$runtime");done
[[ -f "$runtime/run_cavity_motion.py" ]] || { echo 'Missing native process watchdog' >&2;exit 1; }
export PYTHONPATH="$runtime${PYTHONPATH:+:$PYTHONPATH}"
exec /Users/numi/numi-human-prep-venv-20261005/bin/python3 "$here/run_first_touch.py" \
    "$assembly/full-tissue-release/parent" "$here/exact-material-origin" "$out" 16
