// The existing nodal friction owner uses the normal impulse resulting from the
// material-area potential. Off-diagonal normal stiffness acts on neighboring FEM nodes.
inline float3 registeredPlaneRow(
    constant NMPrimalContactArguments& contact, uint pair, float width, float dt,
    device const NMFEMNodeStateGPU* nodes, float planeHeight, device const NMFEMNodeStateGPU* accepted, bool linearize) {
    float normalImpulse=0.f, diagonal=0.f;
    const uint2 range=contact.planeRanges[pair];
    constexpr float gauss[4]={.0694318442f,.3300094782f,.6699905218f,.9305681558f};
    constexpr float weight[4]={.1739274226f,.3260725774f,.3260725774f,.1739274226f};
    constexpr float3 unit[3]={float3(1,0,0),float3(0,1,0),float3(0,0,1)};
    for(uint row=range.x;row<range.x+range.y;++row){
        const uint code=contact.planeCorners[row],f=code/3,k=code%3;
        const uint3 ids=contact.planeFaces[f].xyz;
        const float3 gap=float3(nodes[ids.x].positionAndMass.z,nodes[ids.y].positionAndMass.z,
                                nodes[ids.z].positionAndMass.z)-planeHeight;
        float3 stiff=0.f;
        if(min(gap.x,min(gap.y,gap.z))<width){
            const float4 geometry=contact.planeMeasure[f];
            const float invScale=max(dt*dt*width*width,1.e-20f);
            const float3 mass=float3(nodes[ids.x].positionAndMass.w,nodes[ids.y].positionAndMass.w,nodes[ids.z].positionAndMass.w);
            const float3 oldGap=float3(accepted[ids.x].positionAndMass.z,accepted[ids.y].positionAndMass.z,accepted[ids.z].positionAndMass.z)-planeHeight;
            const float3 oldVelocity=float3(accepted[ids.x].velocityAndInverseMass.z,accepted[ids.y].velocityAndInverseMass.z,accepted[ids.z].velocityAndInverseMass.z);
            // Freeze the material coefficient on the accepted reference nodes.
            // The clipped quadrature domain can then move independently of it.
            const float3 closing=max(-oldVelocity,0.f);
            const float3 rem=max(width-max(oldGap,1.e-4f*width),1.e-3f*width);
            const float3 inertial=10.f/max(dt*dt*width*width/mass,float3(1.e-20f));
            const float3 impact=select(float3(0),closing/max(dt*rem*width*width/mass,float3(1.e-20f)),
                                       oldGap-dt*closing<=width);
            const float unitStiffness=10.f/invScale;
            const float3 density=geometry.yzw*(max(inertial,impact)/unitStiffness);
            float3 clip[4];uint count=0;
            for(uint a=0;a<3;++a){
                const uint b=(a+1)%3;const bool inside=gap[a]<width;
                if(inside) clip[count++]=unit[a];
                if(inside!=(gap[b]<width))clip[count++]=mix(unit[a],unit[b],(width-gap[a])/(gap[b]-gap[a]));
            }
            for(uint part=0;part+2<count;++part){
                const float3 a=clip[0],b=clip[part+1],c=clip[part+2];
                const float area=geometry.x*abs(dot(a,cross(b,c)));
                for(uint i=0;i<4;++i) for(uint j=0;j<4;++j){
                    const float u=gauss[i],v=(1.f-u)*gauss[j];
                    const float3 B=(1.f-u-v)*a+u*b+v*c;
                    const float measure=2.f*(1.f-u)*weight[i]*weight[j]*area*dot(density,B)*B[k];
                    const float4 ipc=ipcBarrierResponse(dot(B,gap),width,1.f,dt,0.f,false,0.f,unitStiffness);
                    normalImpulse+=measure*ipc.x;
                    stiff+=measure*ipc.y*B;
                }
            }
        }
        diagonal+=stiff[k];
        if(linearize) contact.planeOffDiagonal[row]=float2(stiff[(k+1)%3],stiff[(k+2)%3]);
    }
    return float3(normalImpulse,diagonal,width);
}
