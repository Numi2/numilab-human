+kernel void nm_fem_refresh_volume_witness(
+    constant NMMatterDispatchGPU& d [[buffer(0)]],
+    constant NMMicrostepGPU& micro [[buffer(1)]],
+    device const NMContinuumObjectGPU* objects [[buffer(2)]],
+    device const NMMaterialGPU* materials [[buffer(3)]],
+    device const NMFEMNodeStateGPU* accepted [[buffer(4)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(5)]],
+    device float4* direction [[buffer(6)]],
+    device const NMTetrahedronGPU* tets [[buffer(7)]],
+    device const NMSchedulerStateGPU* schedule [[buffer(8)]],
+    device const NMAdaptiveStateGPU* adaptive [[buffer(9)]],
+    device const NMFGMRESStateGPU* states [[buffer(10)]],
+    device uint* rows [[buffer(11)]],
+    constant uint& count [[buffer(12)]],
+    device atomic_uint* claims [[buffer(13)]],
+    device const float4* releaseFloors [[buffer(14)]],
+    constant uint& releaseMode [[buffer(15)]],
+    uint lane [[thread_index_in_simdgroup]], uint group [[threadgroup_position_in_grid]]) {
+    const uint live=rows[count];
+    if(group>=live || live>64 || states[0].nonlinear.w>.5f)return;
+    const uint tile=rows[count+group+1u]&0xffffffu;
+    if(tile>=count || rows[tile]>=d.tetrahedronCount)return;
+    const uint old=rows[tile],owner=tets[old].identity.y;
+    if(owner>=d.objectCount)return;
+    const NMContinuumObjectGPU object=objects[owner];
+    if(!objectDue(object,schedule[owner],adaptive[owner],micro))return;
+    const float dt=objectTimestep(d,schedule[owner]);
+    float score=0.f; uint best=0xffffffffu;
+    for(uint local=tile*256u+lane; local<min(object.elementCount,(tile+1u)*256u); local+=32u){
+        const uint e=object.elementOffset+local;
+        const auto t=tets[e];
+        if(t.identity.y!=owner || !(t.identity.w&NM_OBJECT_ACTIVE))continue;
+        const auto mat=materials[t.identity.x];
+        const float lo=max(max(d.numericalLimits.z,mat.validity.x),releaseMode==2u?releaseFloors[e].z:0.f);
+        const float hi=mat.validity.y;
+        const auto inv=matrixFromRows(t.inverseRestRow0,t.inverseRestRow1,t.inverseRestRow2);
+        const bool reference=(t.identity.w&NM_TETRAHEDRON_REFERENCE_DISPLACEMENT_GRADIENT)!=0;
+        NMFEMNodeStateGPU trial[4];bool movable=true;
+        for(uint k=0;k<4;++k){
+            const uint n=t.nodes[k];const auto state=candidate[n];
+            movable=movable && state.restAndFixed.w<=.5f && state.positionAndMass.w>0.f;
+            trial[k]=femTrialNodeAtAlpha(accepted[n],state,direction[n].xyz,1.f,dt,true);
+        }
+        if(!movable)continue;
+        const float J=determinant(registeredTrialF(trial,inv,reference));
+        if(!isfinite(J) || (J>lo&&J<hi))continue;
+        const float severity=1.f+max(lo-J,J-hi)/max(hi-lo,kEpsilon);
+        if(severity>score || (severity==score && e<best)){score=severity;best=e;}
+    }
+    const float maximum=simd_max(score);
+    const uint winner=simd_min(score==maximum?best:0xffffffffu);
+    if(lane==0 && winner!=0xffffffffu)rows[tile]=winner;
+}
