// Paired cortical material features, in each phalanx's own body frame.
struct NMDigitFeature { uint4 bodies; float4 x[4]; };
struct NMDigitClosest { float3 wa,wb,normal; float gap,s,t,u; };
inline float nmDigitProject(float3 p,float3 x,float3 e){
    return clamp(dot(p-x,e)/dot(e,e),0.f,1.f);
}
inline void nmDigitChoose(thread NMDigitClosest& c,float3 a,float3 b,float s,float t,float u){
    float3 d=a-b;float sq=dot(d,d);
    if(sq<c.gap){c.wa=a;c.wb=b;c.gap=sq;c.s=s;c.t=t;c.u=u;}
}
inline NMDigitClosest nmDigitFeatures(const NMDigitFeature rec,float3 delta,float4 qa,float4 qb){
    bool face=rec.bodies.z!=0;
    float3 a=restingRotate(qa,rec.x[0].xyz);
    uint firstB=face?1u:2u;
    float3 b=delta+restingRotate(qb,rec.x[firstB].xyz);
    float3 v=restingRotate(qb,rec.x[firstB+1].xyz-rec.x[firstB].xyz);
    float3 w=a-b;float cc=dot(v,v);
    NMDigitClosest c={a,b,float3(0),INFINITY,0,0,0};
    float3 n;bool inside=false;
    if(face){
        float3 z=restingRotate(qb,rec.x[3].xyz-rec.x[1].xyz);
        n=cross(v,z);float den=dot(n,n);
        float t=dot(cross(w,z),n)/den,h=dot(cross(v,w),n)/den;
        inside=t>=0 && h>=0 && t+h<=1;
        if(inside)nmDigitChoose(c,a,b+t*v+h*z,0,t,h);
        else{
            float f=nmDigitProject(a,b,v);nmDigitChoose(c,a,b+f*v,0,f,0);
            f=nmDigitProject(a,b,z);nmDigitChoose(c,a,b+f*z,0,0,f);
            f=nmDigitProject(a,b+v,z-v);nmDigitChoose(c,a,b+v+f*(z-v),0,1-f,f);
        }
    }else{
        float3 u=restingRotate(qa,rec.x[1].xyz-rec.x[0].xyz);
        n=cross(u,v);float den=dot(n,n),aa=dot(u,u);
        if(den>1e-12f*aa*cc){
            float s=dot(cross(v,w),n)/den,t=dot(cross(u,w),n)/den;
            inside=s>=0 && s<=1 && t>=0 && t<=1;
            if(inside)nmDigitChoose(c,a+s*u,b+t*v,s,t,0);
        }
        if(!inside){
            float t=nmDigitProject(a,b,v);nmDigitChoose(c,a,b+t*v,0,t,0);
            t=nmDigitProject(a+u,b,v);nmDigitChoose(c,a+u,b+t*v,1,t,0);
            float s=nmDigitProject(b,a,u);nmDigitChoose(c,a+s*u,b,s,0,0);
            s=nmDigitProject(b+v,a,u);nmDigitChoose(c,a+s*u,b+v,s,1,0);
        }
    }
    float3 diff=c.wa-c.wb;
    if(inside){c.normal=normalize(n)*(rec.bodies.w?-1.f:1.f);c.gap=dot(diff,c.normal);}
    else {c.gap=sqrt(c.gap);c.normal=c.gap>0?diff/c.gap:normalize(n)*(rec.bodies.w?-1.f:1.f);}
    return c;
}
inline float3 nmDigitPointJ(device const float* j,uint base,uint dof,uint n,float3 local){
    float3 center=float3(j[base+dof],j[base+n+dof],j[base+2*n+dof]);float3 v=center;
    for(uint ax=0;ax<3;++ax){
        uint k=base+(ax+1)*3*n+dof;
        v+=local[ax]*(float3(j[k],j[k+n],j[k+2*n])-center);
    }
    return v;
}
// Finite cortical triangle pairs in the second body's local coordinates.
struct NMDigitTri { float4 x[3]; };
struct NMDigitPair { float3 a,b; float d2; };
struct NMDigitHit { float4 a,b,n; };
inline void nmDigitTake(thread NMDigitPair& hit,float3 a,float3 b){
    float3 r=a-b;float q=dot(r,r);
    if(q<hit.d2){hit.a=a;hit.b=b;hit.d2=q;}
}
inline void nmDigitVF(thread NMDigitPair& h,float3 p,float3 a,float3 b,float3 c,bool rev){
    float3 e=b-a,f=c-a,n=cross(e,f);float den=dot(n,n);
    if(!(den>0))return;
    float3 w=p-a;float u=dot(cross(w,f),n)/den,v=dot(cross(e,w),n)/den;
    if(u>=0 && v>=0 && u+v<=1){
        float3 q=a+u*e+v*f;
        if(rev)nmDigitTake(h,q,p);else nmDigitTake(h,p,q);
    }
}
inline void nmDigitEE(thread NMDigitPair& h,float3 a,float3 b,float3 c,float3 d){
    float3 e=b-a,f=d-c,w=a-c;float aa=dot(e,e),bb=dot(e,f),cc=dot(f,f),dd=dot(e,w),ee=dot(f,w);
    float3 axis=cross(e,f);float den=dot(axis,axis);
    float s=den>1.e-12f*aa*cc?clamp(dot(cross(f,w),axis)/den,0.f,1.f):0.f;
    float t=(bb*s+ee)/cc;
    if(t<0){t=0;s=clamp(-dd/aa,0.f,1.f);}
    if(t>1){t=1;s=clamp((bb-dd)/aa,0.f,1.f);}
    nmDigitTake(h,a+s*e,c+t*f);
}
inline NMDigitPair nmDigitNearest(thread const float3 *a,thread const float3 *b){
    NMDigitPair hit={a[0],b[0],INFINITY};
    for(uint k=0;k<3;++k){
        nmDigitVF(hit,a[k],b[0],b[1],b[2],false);
        nmDigitVF(hit,b[k],a[0],a[1],a[2],true);
        for(uint j=0;j<3;++j)nmDigitEE(hit,a[k],a[(k+1)%3],b[j],b[(j+1)%3]);
    }
    return hit;
}
inline void nmDigitSAT(thread const float3 *a,thread const float3 *b,float3 n,thread float& gap,thread float3& direction){
    float d=dot(n,n);if(!(d>1.e-26f))return;
    n*=rsqrt(d);float3 x=float3(dot(n,a[0]),dot(n,a[1]),dot(n,a[2]));
    float3 y=float3(dot(n,b[0]),dot(n,b[1]),dot(n,b[2]));
    float gx=min(x.x,min(x.y,x.z))-max(y.x,max(y.y,y.z)),gy=min(y.x,min(y.y,y.z))-max(x.x,max(x.y,x.z));
    if(gx>gap){gap=gx;direction=n;}
    if(gy>gap){gap=gy;direction=-n;}
}
inline bool nmDigitTriangles(thread const float3* a,thread const float3* b,float best,
                             thread float& gap,thread float3& p,thread float3& q,thread float3& n){
    float3 l=max(min(a[0],min(a[1],a[2]))-max(b[0],max(b[1],b[2])),
                 min(b[0],min(b[1],b[2]))-max(a[0],max(a[1],a[2])));
    float3 dist=max(l,0.f);
    if(any(l>0.f) && (best<=0 || dot(dist,dist)>best*best))return false;
    float sat=-INFINITY;float3 direction=0;
    if(all(l<=0)){
        float3 an=cross(a[1]-a[0],a[2]-a[0]),bn=cross(b[1]-b[0],b[2]-b[0]);
        nmDigitSAT(a,b,an,sat,direction);nmDigitSAT(a,b,bn,sat,direction);
        for(uint i=0;i<3 && sat<=0;++i){
            float3 e=a[(i+1)%3]-a[i];
            for(uint j=0;j<3;++j)nmDigitSAT(a,b,cross(e,b[(j+1)%3]-b[j]),sat,direction);
        }
        if(sat<=0){
            // In-plane separating axes handle coplanar disjoint triangles.
            for(uint i=0;i<3;++i){
                nmDigitSAT(a,b,cross(an,a[(i+1)%3]-a[i]),sat,direction);
                nmDigitSAT(a,b,cross(bn,b[(i+1)%3]-b[i]),sat,direction);
            }
        }
        if(sat<=0){
            if(sat>=best)return false;
            float3 moved[3];for(uint k=0;k<3;++k)moved[k]=a[k]-sat*direction;
            auto h=nmDigitNearest(moved,b);
            p=h.a+sat*direction;q=h.b;n=direction;gap=sat;return true;
        }
    }
    if(best<=0)return false;
    auto h=nmDigitNearest(a,b);
    float g=sqrt(h.d2);if(g>=best)return false;
    p=h.a;q=h.b;gap=g;
    if(g>1.e-10f)n=(p-q)/g;
    else {
        float3 t=cross(b[1]-b[0],b[2]-b[0]);n=any(direction!=0.f)?direction:normalize(t);
        if(dot(n,p-q)<0)n=-n;
    }
    return true;
}

kernel void nm_digit_surface_faces(constant uint4& size [[buffer(0)]],constant uint4* ranges [[buffer(1)]],
    device const NMDigitTri* tris [[buffer(2)]],device const NMDigitFeature* features [[buffer(3)]],
    device const MRArticulatedBodyPoseGPU* poses [[buffer(4)]],device const float4* low [[buffer(5)]],
    device NMDigitHit* result [[buffer(6)]],uint gid [[threadgroup_position_in_grid]],uint lane [[thread_index_in_simdgroup]]){
    uint row=gid/size.y,face=gid%size.y;uint4 run=ranges[row];
    if(face>=run.y){if(!lane)result[gid].a.w=INFINITY;return;}
    auto ids=features[row].bodies;uint a=ids.x-size.x,b=ids.y-size.x;
    float4 qa=poses[a].orientation,qb=poses[b].orientation;
    float4 iqb=float4(-qb.xyz,qb.w),iqa=float4(-qa.xyz,qa.w);
    float3 delta=(poses[a].position.xyz-poses[b].position.xyz)+(low[a].xyz-low[b].xyz);
    float3 av[3];for(uint i=0;i<3;++i)av[i]=restingRotate(iqb,delta+restingRotate(qa,tris[run.x+face].x[i].xyz));
    float gap=INFINITY;float3 p=0,q=0,n=0;uint winner=UINT_MAX;
    for(uint k=lane;k<run.w;k+=32){
        float3 bv[3];for(uint j=0;j<3;++j)bv[j]=tris[run.z+k].x[j].xyz;
        float d;float3 x,y,t;
        if(nmDigitTriangles(av,bv,gap,d,x,y,t)){gap=d;p=x;q=y;n=t;winner=k;}
    }
    float minGap=simd_min(gap);uint best=simd_min(gap==minGap?winner:UINT_MAX);
    if(winner==best && gap==minGap && (best!=UINT_MAX || !lane)){
        result[gid].a=float4(restingRotate(iqa,restingRotate(qb,p)-delta),gap);
        result[gid].b=float4(q,as_type<float>(winner));
        result[gid].n=float4(restingRotate(qb,n),as_type<float>(face));
    }
}

kernel void nm_human_digit_cortical_rows(constant uint4& dim [[buffer(0)]],constant uint4& rows [[buffer(1)]],
    device const NMDigitFeature* features [[buffer(2)]],device const MRArticulatedBodyPoseGPU* poses [[buffer(3)]],
    device const float4* low [[buffer(4)]],device MRArticulatedPointWorldGPU* points [[buffer(5)]],
    device float4* pointLow [[buffer(6)]],device float* j [[buffer(7)]],
    device MRNumiHumanStandContactGPU* contacts [[buffer(8)]],device float4* trace [[buffer(9)]],
    constant float4& representation [[buffer(10)]],constant float4& origin [[buffer(11)]],
    device float4* observedPose [[buffer(12)]],device const NMDigitHit* hits [[buffer(13)]],constant uint& stride [[buffer(14)]],
    uint row [[threadgroup_position_in_grid]],uint lane [[thread_index_in_threadgroup]]){
    threadgroup float4 tmp[3];
    NMDigitFeature rec=features[row];uint a=rec.bodies.x-dim.x,b=rec.bodies.y-dim.x;
    uint cid=rows.x+row,pid=rows.y+row,n=dim.y;
    // The accepted input of the physical step is read from the native owner.
    // Each side has two registered features on the same rigid pair.
    if(dim.w<rows.w && !rows.z && !(row&1u) && lane<2){
        uint bidx=lane?b:a;
        uint off=(4*dim.w+row+lane)*3;
        observedPose[off]=float4(poses[bidx].position.xyz,1);
        observedPose[off+1]=float4(low[bidx].xyz,0);
        observedPose[off+2]=poses[bidx].orientation;
    }
    float minGap=INFINITY;uint best=UINT_MAX;
    for(uint k=lane;k<stride;k+=32){
        float g=hits[row*stride+k].a.w;
        if(g<minGap){minGap=g;best=k;}
    }
    float globalGap=simd_min(minGap);uint index=simd_min(minGap==globalGap?best:UINT_MAX);
    if(lane==0){
        auto h=hits[row*stride+index];
        NMDigitClosest c={h.a.xyz,h.b.xyz,h.n.xyz,h.a.w,float(index),float(as_type<uint>(h.b.w)),0};
        tmp[0]=h.a;tmp[1]=h.b;tmp[2]=h.n;
        float3 solverNormal=representation.w==1.f?c.normal:representation.xyz;
        float3 base=representation.w==1.f?float3(0):origin.xyz;
        float3 offset=solverNormal*c.gap,high=base+offset;
        points[pid].position=float4(high,0);pointLow[pid]=float4(offset-(high-base),0);
        contacts[cid].planePoint=0;contacts[cid].planeNormal=representation.w==1.f?float4(c.normal,0):float4(0);
        if(dim.w<rows.w)trace[(dim.w*2+rows.z)*4+row]=float4(c.gap,c.s,c.t,c.u);
    }
    threadgroup_barrier(mem_flags::mem_threadgroup);
    for(uint dof=lane;dof<n;dof+=32){
        float3 ja=nmDigitPointJ(j,(dim.z+4*a)*3*n,dof,n,tmp[0].xyz);
        float3 jb=nmDigitPointJ(j,(dim.z+4*b)*3*n,dof,n,tmp[1].xyz);
        float3 rel=ja-jb;
        if(representation.w==0.f){
            // Express the relative three-dimensional row in the existing flat
            // solver basis. Dotting its normal gives exactly n.(J_A-J_B).
            float3 n=tmp[2].xyz,g=representation.xyz;
            float3 t=normalize(cross(abs(n.x)<.8f?float3(1,0,0):float3(0,1,0),n));
            float3 h=normalize(cross(abs(g.x)<.8f?float3(1,0,0):float3(0,1,0),g));
            rel=g*dot(n,rel)+h*dot(t,rel)+cross(g,h)*dot(cross(n,t),rel);
        }
        uint k=pid*3*n+dof;j[k]=rel.x;j[k+n]=rel.y;j[k+2*n]=rel.z;
    }
}
