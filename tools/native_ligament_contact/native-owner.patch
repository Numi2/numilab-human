+// The fixed prefix ends at a material vertex on body 0. Its path and prefix
+// length are invariant under rigid motion while its vertex reaction remains
+// inside the normal cone. Minimize the remaining length on the certified edges.
+inline bool ligamentConePair(float3 g, float3 a, float3 b, float tol) {
+    float c=dot(a,b), det=dot(cross(a,b),cross(a,b));
+    if (length(g-a*max(0.0f,dot(a,g)))<=tol ||
+        length(g-b*max(0.0f,dot(b,g)))<=tol) return true;
+    if (det<=1.e-10f) return false;
+    float x=(dot(g,a)-c*dot(g,b))/det;
+    float y=(dot(g,b)-c*dot(g,a))/det;
+    return x>=0 && y>=0 && length(g-x*a-y*b)<=tol;
+}
+inline bool ligamentVertexSupports(device const NMNumiHumanLigamentContactStripGPU& route,float3 g,float tol) {
+    if (length(g)<=tol) return true;
+    for (uint i=0;i<route.pivotNormalCount;i++) {
+        float3 a=route.pivotNormal[i].xyz;
+        for (uint j=i+1;j<route.pivotNormalCount;j++) {
+            float3 b=route.pivotNormal[j].xyz;
+            if (ligamentConePair(g,a,b,tol)) return true;
+            for (uint k=j+1;k<route.pivotNormalCount;k++) {
+                float3 c=route.pivotNormal[k].xyz;
+                float det=dot(a,cross(b,c));
+                if (abs(det)<1.e-6f) continue;
+                float3 coeff=float3(dot(g,cross(b,c)),dot(g,cross(c,a)),dot(g,cross(a,b)))/det;
+                if (all(coeff>=0.0f) && length(g-coeff.x*a-coeff.y*b-coeff.z*c)<=tol) return true;
+            }
+        }
+    }
+    return false;
+}
+inline bool ligamentContactStrip(device const NMNumiHumanLigamentContactStripGPU& r,
+    float3 insertion,float3 insertionNormal,thread float3& last,thread float& materialLength) {
+    const uint n=r.edgeCount;
+    if (!n||n>NM_LIGAMENT_STRIP_EDGES||r.pivotNormalCount<2||r.pivotNormalCount>NM_LIGAMENT_VERTEX_NORMALS) return false;
+    float3 p[NM_LIGAMENT_STRIP_EDGES+2], tangent[NM_LIGAMENT_STRIP_EDGES];
+    float extent[NM_LIGAMENT_STRIP_EDGES];
+    p[0]=r.pivotAndPrefixLength.xyz;p[n+1]=insertion;
+    for(uint i=0;i<n;i++) {
+        float3 edge=r.edge[i].end.xyz-r.edge[i].startAndSeed.xyz;
+        extent[i]=length(edge);
+        if (!(extent[i]>1.e-8f)) return false;
+        tangent[i]=edge/extent[i];
+        p[i+1]=r.edge[i].startAndSeed.xyz+edge*r.edge[i].startAndSeed.w;
+    }
+    // For one edge the minimizer is exact by equal tangent projections of
+    // its two adjacent unit spans. Alternating sweeps converge on the convex
+    // fixed-feature problem. Stationarity and outward reactions decide success.
+    constexpr float coneTolerance=3.e-5f;
+    for(uint sweep=0;sweep<96;sweep++) {
+        for(uint j=0;j<n;j++) {
+            uint i=(sweep&1)?n-1-j:j;
+            float3 origin=r.edge[i].startAndSeed.xyz;
+            float3 l=p[i]-origin, h=p[i+2]-origin, axis=tangent[i];
+            float a=dot(l,axis),b=dot(h,axis);
+            float r0=length(l-a*axis),r1=length(h-b*axis);
+            if (!(r0+r1>1.e-9f)) return false;
+            p[i+1]=origin+clamp((a*r1+b*r0)/(r0+r1),0.0f,extent[i])*axis;
+        }
+        float3 u=normalize(p[1]-p[0]); bool stationary=true;
+        for(uint i=0;i<n;i++) {
+            float3 next=normalize(p[i+2]-p[i+1]);
+            if (!(abs(dot(u-next,tangent[i]))<1.e-5f)) {stationary=false;break;}
+            u=next;
+        }
+        if (!stationary) continue;
+        u=normalize(p[1]-p[0]);
+        if (!ligamentVertexSupports(r,r.incomingUnit.xyz-u,coneTolerance)) return false;
+        materialLength=r.pivotAndPrefixLength.w+distance(p[1],p[0]);
+        for(uint i=0;i<n;i++) {
+            float t=dot(p[i+1]-r.edge[i].startAndSeed.xyz,tangent[i])/extent[i];
+            if (!(t>0.0f && t<1.0f)) return false;
+            float3 d=p[i+2]-p[i+1];float len=length(d);
+            if (!(len>1.e-8f)) return false;
+            float3 next=d/len;
+            if (!ligamentConePair(u-next,r.edge[i].normal0.xyz,r.edge[i].normal1.xyz,coneTolerance)) return false;
+            materialLength+=len;u=next;
+        }
+        if (dot(-u,insertionNormal)<-coneTolerance) return false;
+        last=p[n];return isfinite(materialLength);
+    }
+    return false;
+}
