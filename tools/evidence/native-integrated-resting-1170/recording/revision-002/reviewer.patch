+def copy_registered_input(source: Path, destination: Path, expected_sha256: str):
+    source = Path(source)
+    before = require_user_immutable(source)
+    if sha(source) != expected_sha256:
+        raise ValueError("registered source differs from receipt before copying")
+    if destination.exists() or destination.is_symlink():
+        raise FileExistsError("refusing to overwrite review input")
+    # UF_IMMUTABLE forbids adding hard links on APFS. Copy exact bytes to an
+    # independent review inode without changing retained source protection.
+    with source.open("rb") as src, destination.open("xb") as dst:
+        shutil.copyfileobj(src, dst, 8 * 1024 * 1024)
+    if os.path.samefile(source, destination):
+        raise ValueError("review copy unexpectedly aliases source inode")
+    if sha(destination) != expected_sha256 or sha(source) != expected_sha256:
+        raise ValueError("copied review input differs from registered receipt")
+    after = require_user_immutable(source)
+    if before != after:
+        raise ValueError("registered source protection changed during copy")
+    return {"source_path": str(source), "review_path": str(destination),
+            "sha256": expected_sha256, "bytes": destination.stat().st_size,
+            "same_device": source.stat().st_dev == destination.stat().st_dev,
+            "same_inode": False, "source_flags_before": before,
+            "source_flags_after": after}
+
