 #include "tetgen.h"
+#include <vector>
+#include "tetgen_hull_region_attribute_controls.h"
+
+// Hull-to-real flip attribute repair. Hull tetrahedra carry default attributes;
+// when a flip turns one into a real cell, inherit the complete tuple from the
+// real tet across its old face opposite dummypoint. If that owner is absent,
+// or a real output cell disagrees across an unprotected real face, emit an
+// invalid region marker instead of guessing.
+struct TetgenHullAttrSnapshot {
+  bool was_hull;
+  bool valid;
+  std::vector<REAL> attributes;
+  REAL volume;
+  TetgenHullAttrSnapshot() : was_hull(false), valid(false), volume(-1.0) {}
+};
+static long tetgen_hull_attr_invalid_count = 0;
+static bool tetgen_tet_has_dummy(tetgenmesh *m, tetgenmesh::triface t)
+{
+  for (int v = 0; v < 4; ++v) {
+    if ((tetgenmesh::point) t.tet[4 + v] == m->dummypoint) return true;
+  }
+  return false;
+}
+static void tetgen_capture_hull_attr(tetgenmesh *m, tetgenmesh::triface oldtet,
+                                    TetgenHullAttrSnapshot &snap)
+{
+  int dummy_index = -1;
+  for (int v = 0; v < 4; ++v) {
+    if ((tetgenmesh::point) oldtet.tet[4 + v] == m->dummypoint) {
+      dummy_index = v; break;
+    }
+  }
+  if (dummy_index < 0) return;
+  snap.was_hull = true;
+  if (m->numelemattrib <= 0) { snap.valid = true; return; }
+  tetgenmesh::triface face = oldtet, realtet;
+  face.ver = dummy_index;
+  m->fsym(face, realtet);
+  if (realtet.tet == NULL || tetgen_tet_has_dummy(m, realtet)) return;
+  snap.attributes.resize(m->numelemattrib);
+  for (int a = 0; a < m->numelemattrib; ++a) {
+    snap.attributes[a] = m->elemattribute(realtet.tet, a);
+  }
+  if (m->b->varvolume) snap.volume = m->volumebound(realtet.tet);
+  snap.valid = true;
+}
+static bool tetgen_restore_hull_attr(tetgenmesh *m, tetgenmesh::triface output,
+                                    const TetgenHullAttrSnapshot &snap)
+{
+  std::vector<REAL> output_attributes;
+  REAL output_volume = -1.0;
+  const tetgen_hull_region_attribute_controls::RestoreResult result =
+      tetgen_hull_region_attribute_controls::inherit_real_neighbor_tuple(
+          snap.was_hull, tetgen_tet_has_dummy(m, output), snap.valid,
+          (size_t) m->numelemattrib, snap.attributes, snap.volume,
+          output_attributes, output_volume);
+  if (result == tetgen_hull_region_attribute_controls::kNoHullToRealTransition) {
+    return false;
+  }
+  if (result == tetgen_hull_region_attribute_controls::kMissingOrMalformedRealOwner) {
+    if (m->b->regionattrib && m->numelemattrib > 0) {
+      m->setelemattribute(output.tet, m->numelemattrib - 1, -2.0);
+    }
+    ++tetgen_hull_attr_invalid_count;
+    return true;
+  }
+  for (int a = 0; a < m->numelemattrib; ++a) {
+    m->setelemattribute(output.tet, a, output_attributes[a]);
+  }
+  if (m->b->varvolume) m->setvolumebound(output.tet, output_volume);
+  return true;
+}
+static void tetgen_validate_hull_attr_interfaces(tetgenmesh *m,
+                                                tetgenmesh::triface *outputs,
+                                                int count)
+{
+  if (!m->b->regionattrib || m->numelemattrib <= 0) return;
+  int attrnum = m->numelemattrib - 1;
+  for (int i = 0; i < count; ++i) {
+    if (tetgen_tet_has_dummy(m, outputs[i])) continue;
+    REAL attr = m->elemattribute(outputs[i].tet, attrnum);
+    for (int f = 0; f < 4; ++f) {
+      tetgenmesh::triface face = outputs[i], neighbor;
+      face.ver = f;
+      if (issubface(face)) continue;
+      m->fsym(face, neighbor);
+      if (neighbor.tet == NULL || tetgen_tet_has_dummy(m, neighbor)) continue;
+      if (tetgen_hull_region_attribute_controls::unprotected_real_region_conflict(
+              false, attr, m->elemattribute(neighbor.tet, attrnum))) {
+        m->setelemattribute(outputs[i].tet, attrnum, -2.0);
+        ++tetgen_hull_attr_invalid_count;
+        attr = -2.0;
+      }
+    }
+  }
+}
 
