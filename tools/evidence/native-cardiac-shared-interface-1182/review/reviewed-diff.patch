+def _outside_connected_boundary_patches(mesh, other, shared_keys, blocked_edges):
+    """Classify open boundary patches after all face crossings are checked.
+
+    Every non-interface face interior is certified uncut by the caller, and
+    every edge touched by the opposite surface is blocked, even at one point.
+    An open path through remaining face interiors and edges cannot cross that
+    surface, so one exact parity witness classifies each connected patch.
+    """
+    remaining = {i for i, tri in enumerate(mesh.triangles)
+                 if tuple(sorted(tri)) not in shared_keys}
+    face_count = len(remaining)
+    edges = defaultdict(list)
+    for i in remaining:
+        tri = mesh.triangles[i]
+        for a, b in zip(tri, tri[1:]+tri[:1]):
+            edge = _edge_key(a, b)
+            if edge not in blocked_edges:
+                edges[edge].append(i)
+    adjacency = defaultdict(list)
+    for rows in edges.values():
+        require(len(rows) <= 2, 'nonmanifold open boundary patch')
+        if len(rows) == 2:
+            a, b = rows
+            adjacency[a].append(b); adjacency[b].append(a)
+    witnesses = []
+    while remaining:
+        seed = min(remaining); remaining.remove(seed)
+        stack = [seed]; count = 0
+        while stack:
+            i = stack.pop(); count += 1
+            for j in adjacency[i]:
+                if j in remaining:
+                    remaining.remove(j); stack.append(j)
+        tri = mesh.triangles[seed]
+        center = tuple(Fraction(sum(p[k] for p in tri), 3) for k in range(3))
+        require(other.location(center) == 'outside',
+                'non-interface emitted boundary patch is inside the other region')
+        witnesses.append({'representative_face': seed, 'face_count': count})
+    return face_count, witnesses
+
