{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi.example/schemas/human-organ-geometry-component-moments.v1.schema.json",
  "title": "Numi Human conservative disconnected organ source moments",
  "type": "object",
  "required": [
    "schema",
    "compiler",
    "inventory_schema",
    "inventory_sha256",
    "archive",
    "counts",
    "status_counts",
    "regions",
    "members",
    "qualification",
    "boundary"
  ],
  "properties": {
    "schema": {"const": "HumanPack.organ-geometry-component-moments.v1"},
    "compiler": {"const": "numilab-human.organ-geometry-component-moments.1"},
    "inventory_schema": {"const": "HumanPack.organ-geometry-inventory.v1"},
    "inventory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "archive": {"$ref": "#/$defs/artifact"},
    "archive_sha256_recomputed": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "counts": {"type": "object", "required": ["region_count", "member_count", "moment_computed_member_count", "single_closed_component_member_count", "disjoint_closed_component_sum_member_count", "not_disjoint_component_bounds_member_count", "source_topology_defective_member_count"]},
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "regions": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "member_ids", "member_count", "moment_status_counts"]}},
    "members": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/member"}},
    "qualification": {"type": "object", "required": ["source_inventory_recomputed", "single_closed_surface_integrals_computed", "disjoint_closed_component_sums_computed", "component_aabb_disjointness_checked", "watertight_union_performed", "body_frame_registered", "material_assigned", "blood_mass_assigned", "physical_volume_authority_assigned", "physical_stepping", "physiological_calibration"]},
    "boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["file", "sha256", "bytes"],
      "properties": {
        "file": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "member": {
      "type": "object",
      "required": ["member_id", "archive_member", "source_sha256", "moment_status", "face_component_count", "unused_quotient_vertex_count", "component_aabb_disjoint_checked", "component_aabb_disjoint", "source_surface_moments", "physical_volume_m3", "mechanical_mass_kg", "body_registration"],
      "properties": {
        "member_id": {"type": "string", "minLength": 1},
        "archive_member": {"type": "string", "minLength": 1},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "moment_status": {"enum": ["computed_single_closed_component", "computed_disjoint_closed_component_sum", "not_disjoint_component_bounds", "source_topology_defective"]},
        "face_component_count": {"type": "integer", "minimum": 1},
        "unused_quotient_vertex_count": {"type": "integer", "minimum": 0},
        "component_aabb_disjoint_checked": {"type": "boolean"},
        "component_aabb_disjoint": {"type": ["boolean", "null"]},
        "source_surface_moments": {"type": ["object", "null"]},
        "physical_volume_m3": {"type": ["number", "null"]},
        "mechanical_mass_kg": {"type": ["number", "null"]},
        "body_registration": {"const": false}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
