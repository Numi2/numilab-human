{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi.example/schemas/human-addbiomechanics-acquisition.v1.schema.json",
  "title": "Numi Human AddBiomechanics one-subject acquisition receipt",
  "type": "object",
  "required": ["schema", "compiler", "status", "dataset", "subject", "model", "channels", "trials", "qualification", "boundary"],
  "properties": {
    "schema": {"const": "HumanPack.addbiomechanics-acquisition.v1"},
    "compiler": {"const": "numilab-human.addbiomechanics-acquisition.1"},
    "status": {"const": "source_acquired"},
    "dataset": {
      "type": "object",
      "required": ["id", "version", "download_page", "license", "archive_url", "archive_entry", "archive_compressed_bytes", "archive_compressed_sha256", "source_artifact", "source_artifact_raw_bytes", "source_artifact_raw_sha256"],
      "properties": {
        "id": {"const": "addbiomechanics-core-v1"},
        "version": {"const": "1.0"},
        "download_page": {"format": "uri"},
        "license": {"const": "CC BY 4.0"},
        "archive_url": {"format": "uri"},
        "archive_entry": {"type": "string", "minLength": 1},
        "archive_compressed_bytes": {"type": "integer", "minimum": 1},
        "archive_compressed_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_artifact": {"$ref": "#/$defs/artifact"},
        "source_artifact_raw_bytes": {"type": "integer", "minimum": 1},
        "source_artifact_raw_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "required": ["id", "sex", "age_years", "height_m", "mass_kg", "href", "tags"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "sex": {"const": "male"},
        "age_years": {"type": "integer", "minimum": 18, "maximum": 120},
        "height_m": {"type": "number", "exclusiveMinimum": 0},
        "mass_kg": {"type": "number", "exclusiveMinimum": 0},
        "href": {"format": "uri"},
        "tags": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "model": {"type": "object"},
    "channels": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "trials": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "qualification": {"type": "object"},
    "boundary": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
