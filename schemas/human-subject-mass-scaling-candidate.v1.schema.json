{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi.example/schemas/human-subject-mass-scaling-candidate.v1.schema.json",
  "title": "Numi Human subject mass scaling candidate",
  "type": "object",
  "required": ["schema", "compiler", "status", "inputs", "subject", "source_mass", "scaling", "bodies", "qualification", "blockers", "boundary"],
  "properties": {
    "schema": {"const": "HumanPack.subject-mass-scaling-candidate.v1"},
    "compiler": {"const": "numilab-human.subject-mass-scaling-candidate.1"},
    "status": {"const": "partial"},
    "inputs": {"type": "object", "minProperties": 2},
    "subject": {"type": "object"},
    "source_mass": {"type": "object"},
    "scaling": {"type": "object"},
    "bodies": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "qualification": {"type": "object"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
