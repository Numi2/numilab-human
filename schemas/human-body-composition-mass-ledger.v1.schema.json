    "inputs": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
    "scalar_mass_closure": {"type": "object", "required": ["source_rigid_body_mass_kg", "target_subject_mass_kg", "scaled_mass_kg", "closure_error_kg", "target_closed", "mechanical_subject_calibrated"]},
    "candidate_scopes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "object"}},
