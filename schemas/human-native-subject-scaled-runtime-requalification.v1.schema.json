{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://numi.example/schemas/human-native-subject-scaled-runtime-requalification.v1.schema.json",
  "title": "Numi Human native subject-scaled runtime requalification",
  "type": "object",
  "required": ["schema", "status", "subject", "source", "inputs", "native_capture", "command", "results", "qualification", "blockers", "boundary"],
  "properties": {
    "schema": {"const": "HumanPack.native-subject-scaled-runtime-requalification.v1"},
    "status": {"const": "partial"},
    "subject": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "inputs": {"type": "object"},
    "native_capture": {"type": "object"},
    "command": {"type": "object"},
    "results": {"type": "object"},
    "qualification": {"type": "object"},
    "blockers": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
