#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Bind selected torso organ, vessel, and spinal-cord surfaces to exact MyoSim source/core body frames without admitting mechanics.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$repository_root/src:$PYTHONPATH"
else
    export PYTHONPATH="$repository_root/src"
fi
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.torso_body_links "$@"
