#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Compile pinned CVSim21 regional blood-volume source variants into native Matter inputs; retain original-source provenance and explicit model corrections.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$repository_root/src:$PYTHONPATH"
else
    export PYTHONPATH="$repository_root/src"
fi
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.cvsim21 "$@"
