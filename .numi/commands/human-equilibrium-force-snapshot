#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Convert the native compiled Human equilibrium reaction record into a canonical 128-DoF force snapshot with fail-closed sign reconstruction.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
if [ -n "${PYTHONPATH:-}" ]; then
    export PYTHONPATH="$repository_root/src:$PYTHONPATH"
else
    export PYTHONPATH="$repository_root/src"
fi
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.equilibrium_force_snapshot "$@"
