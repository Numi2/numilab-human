    fi
    exec "$@"
fi

# This is the equivalent bounded muscle-force sensitivity capture with the
# exact posterior-calf source surfaces. The native probe poses every surface
# from its two named MyoSim bodies after the 416-muscle Core step, so tendon
# endpoints remain continuous with their driving skeleton. An optional
# activation requests the source-default incremental force (zero-activation
# pre-stress is removed), and no Python is started by this command.
if [ "${1:-}" = "myosim-native-muscle-soft-tissue-visuals" ]; then
    if [ "$#" -lt 6 ] || [ $(( ($# - 6) % 2 )) -ne 0 ]; then
        printf '%s\n' "usage: numi human myosim-native-muscle-soft-tissue-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> <focus-body-index> [--muscle-step-seconds <1e-6..1e-3>] [--muscle-step-count <1..64>] [--muscle-activation <0..1>] [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    focus_body_index=$6
    shift 6
    muscle_step_seconds=0.001
    muscle_step_count=1
    muscle_activation=
    frame_dimension=
    saw_muscle_step=0
    saw_muscle_step_count=0
    saw_muscle_activation=0
    saw_dimension=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --muscle-step-seconds)
                if [ "$saw_muscle_step" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-seconds may be given only once" >&2
                    exit 2
                fi
                muscle_step_seconds=$2
                saw_muscle_step=1
                ;;
            --muscle-step-count)
                if [ "$saw_muscle_step_count" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-count may be given only once" >&2
                    exit 2
                fi
                muscle_step_count=$2
                saw_muscle_step_count=1
                ;;
            --muscle-activation)
                if [ "$saw_muscle_activation" -ne 0 ]; then
                    printf '%s\n' "--muscle-activation may be given only once" >&2
                    exit 2
                fi
                muscle_activation=$2
                saw_muscle_activation=1
                ;;
            --dimension)
                if [ "$saw_dimension" -ne 0 ]; then
                    printf '%s\n' "--dimension may be given only once" >&2
                    exit 2
                fi
                frame_dimension=$2
                saw_dimension=1
                ;;
            *)
                printf '%s\n' "unknown native muscle-soft-tissue visual option $1" >&2
                exit 2
