#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Build NumiLab Human artifacts and run native full-body references, persistent muscle-driven standing, and four-angle visual validation.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)

# Canonical Numi Human v1 standing transaction. The native runtime compiles a
# bounded posture activation from all 416 current-pose source force rows and
# 51 exact source joint equalities, then executes assisted and zero-root-wrench
# horizons in persistent Apple Metal.
# Four native camera frames and a bitwise replay are mandatory evidence.
if [ "${1:-}" = "stand" ]; then
    if [ "${2:-}" = "--help" ] || [ "${2:-}" = "-h" ]; then
        printf '%s\n' "usage: numi human stand <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <NHTENDON2-attachments.nhtendon> <myosim-fullbody-support-contact.nhcnt> <output-directory> [--steps <1..64>] [--timestep <1e-6..1e-3>] [--dimension <512..2048>] [--soft-tissue-payload <NHTISS2-or-NHTISS3>]"
        exit 0
    fi
    if [ "$#" -lt 6 ]; then
        printf '%s\n' "usage: numi human stand <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <NHTENDON2-attachments.nhtendon> <myosim-fullbody-support-contact.nhcnt> <output-directory> [--steps <1..64>] [--timestep <1e-6..1e-3>] [--dimension <512..2048>] [--soft-tissue-payload <NHTISS2-or-NHTISS3>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    tendon_payload=$4
    support_payload=$5
    output_directory=$6
    shift 6
    steps=64
    timestep=0.0001
    dimension=640
    soft_tissue_payload=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --steps)
                [ "$#" -ge 2 ] || { printf '%s\n' "--steps requires one value" >&2; exit 2; }
                steps=$2
                shift 2
                ;;
            --timestep)
                [ "$#" -ge 2 ] || { printf '%s\n' "--timestep requires one value" >&2; exit 2; }
                timestep=$2
                shift 2
                ;;
            --dimension)
                [ "$#" -ge 2 ] || { printf '%s\n' "--dimension requires one value" >&2; exit 2; }
                dimension=$2
                shift 2
                ;;
            --soft-tissue-payload)
                [ "$#" -ge 2 ] || { printf '%s\n' "--soft-tissue-payload requires one value" >&2; exit 2; }
                [ -z "$soft_tissue_payload" ] || { printf '%s\n' "--soft-tissue-payload may be given only once" >&2; exit 2; }
                soft_tissue_payload=$2
                shift 2
                ;;
            *)
                printf '%s\n' "unknown Numi Human stand option $1" >&2
                exit 2
                ;;
        esac
    done
    if [ -z "$soft_tissue_payload" ] && \
       [ -f "$repository_root/Build/bodyparts3d-myosim-fullbody-muscle-surfaces/bodyparts3d-myosim-fullbody-muscle-surfaces.nhtissue" ]; then
        soft_tissue_payload=$repository_root/Build/bodyparts3d-myosim-fullbody-muscle-surfaces/bodyparts3d-myosim-fullbody-muscle-surfaces.nhtissue
    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Numi Human stand probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" "$output_directory" \
        --tendon-payload "$tendon_payload" \
        --support-contact-payload "$support_payload" \
        --joint-equality-payload "$artifact_directory/myosim-fullbody-joint-equalities.nheq" \
        --muscle-step-seconds "$timestep" \
        --muscle-step-count "$steps" \
        --muscle-activation 1 \
        --persistent-metal-stand \
        --stand-root-assistance \
        --stand-remove-assistance \
        --stand-deterministic-replay \
        --source-route-centrelines \
        --dimension "$dimension"
    if [ -n "$soft_tissue_payload" ]; then
        set -- "$@" --soft-tissue-payload "$soft_tissue_payload"
    fi
    exec "$@"
fi

# Canonical Numi-owned Human probe. NHRIGID2/NHMYO1 remain source payloads,
# while NHTENDON1/2 supplies complete route endpoint ownership and NHTENDON2
# adds admitted surface envelopes. The native probe resolves the terminal-load
# program while retaining the existing single J^T rigid-force projection.
if [ "${1:-}" = "tendon-probe" ] || [ "${1:-}" = "probe" ]; then
    if [ "$#" -ne 3 ] && [ "$#" -ne 4 ]; then
        printf '%s\n' "usage: numi human ${1:-tendon-probe} <artifact-directory> <numi-human-tendon-endpoints.nhtendon> [--metal]" >&2
        exit 2
    fi
    if [ "$#" -eq 4 ] && [ "$4" != "--metal" ]; then
        printf '%s\n' "usage: numi human $1 <artifact-directory> <numi-human-tendon-endpoints.nhtendon> [--metal]" >&2
        exit 2
    fi
    artifact_directory=$2
    tendon_payload=$3
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_reference_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Numi Human probe is unavailable: $probe" >&2
        exit 2
    fi
    if [ "$#" -eq 4 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$tendon_payload" --metal
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$tendon_payload"
fi

# Numi-owned anatomical render. The resolved NHTENDON1/2 site program feeds the
# Metal route force path and the native BodyParts3D renderer.
if [ "${1:-}" = "render" ]; then
    if [ "$#" -ne 6 ] && { [ "$#" -ne 8 ] || [ "$7" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human render <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <numi-human-tendon-endpoints.nhtendon> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    tendon_payload=$5
    output_directory=$6
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Numi Human visual probe is unavailable: $probe" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload" \
        --tendon-payload "$tendon_payload"
    if [ "${7:-}" = "--dimension" ]; then
        set -- "$@" --dimension "$8"
    fi
    exec "$@"
fi

# The production-facing source-complete full-body reference never starts a
# Python process.  Python remains only in the offline upstream import adapter
# below, where MyoSim itself owns model composition.  Keeping this command
# native prevents the source convenience layer becoming a Numi runtime.
if [ "${1:-}" = "myosim-native-probe" ]; then
    if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
        printf '%s\n' "usage: numi human myosim-native-probe <artifact-directory> [--metal]" >&2
        exit 2
    fi
    if [ "$#" -eq 3 ] && [ "$3" != "--metal" ]; then
        printf '%s\n' "usage: numi human myosim-native-probe <artifact-directory> [--metal]" >&2
        exit 2
    fi
    artifact_directory=$2
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_reference_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_reference_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 3 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            --metal
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo"
fi

# This capture has the same no-Python runtime boundary as the full-body
# reference probe.  The source-default pose comes from the Metal articulated
# operator; Core's visual renderer then binds inertial-body proxies and the
# compiled MyoSim route-centerline evidence to that pose.
if [ "${1:-}" = "myosim-native-visuals" ]; then
    if [ "$#" -ne 3 ]; then
        printf '%s\n' "usage: numi human myosim-native-visuals <artifact-directory> <output-directory>" >&2
        exit 2
    fi
    artifact_directory=$2
    output_directory=$3
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$output_directory"
fi

# The source-prepared .nhbones package is consumed only by the native C++/Metal
# capture path.  It binds exact BodyParts3D visual-skeleton triangles to the current
# Metal articulated-body pose; Python is not started for this command.
if [ "${1:-}" = "myosim-native-bone-visuals" ]; then
    if [ "$#" -ne 4 ] && { [ "$#" -ne 6 ] || [ "$5" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-bone-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 6 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --dimension "$6"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory"
fi

# The compact NHANAT1 layer keeps exact selected BodyParts3D organ, vessel,
# and spinal-cord triangles in their registered MyoSim torso/abdomen links.
# It remains a native C++/Metal inspection path, not an organ material model.
if [ "${1:-}" = "myosim-native-torso-anatomy-visuals" ]; then
    if [ "$#" -ne 5 ] && { [ "$#" -ne 7 ] || [ "$6" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-torso-anatomy-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-torso-anatomy.nhanatomy> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    torso_anatomy_payload=$4
    output_directory=$5
    frame_dimension=
    if [ "$#" -eq 7 ]; then
        frame_dimension=$7
    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --torso-anatomy-payload "$torso_anatomy_payload" \
        --focus-body-index 20 \
        --muscle-step-seconds 0.0001 \
        --muscle-step-count 1 \
        --muscle-activation 0.05
    if [ -n "$frame_dimension" ]; then
        set -- "$@" --dimension "$frame_dimension"
    fi
    exec "$@"
fi

# This is intentionally a bounded sensitivity capture rather than a simulation
# loop: the complete source muscle set is projected by the retained Metal
# articulated operator, compared against a matched device passive baseline,
# then Core FP64 advances the currently unsupported full-body state step and
# the native Metal path poses/renders that q. Python is never started.
if [ "${1:-}" = "myosim-native-muscle-bone-visuals" ]; then
    if [ "$#" -lt 4 ] || [ $(( ($# - 4) % 2 )) -ne 0 ]; then
        printf '%s\n' "usage: numi human myosim-native-muscle-bone-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> [--muscle-step-seconds <1e-6..1e-3>] [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    shift 4
    muscle_step_seconds=0.001
    frame_dimension=
    saw_muscle_step=0
    saw_dimension=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --muscle-step-seconds)
                if [ "$saw_muscle_step" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-seconds may be given only once" >&2
                    exit 2
                fi
                muscle_step_seconds=$2
                saw_muscle_step=1
                ;;
            --dimension)
                if [ "$saw_dimension" -ne 0 ]; then
                    printf '%s\n' "--dimension may be given only once" >&2
                    exit 2
                fi
                frame_dimension=$2
                saw_dimension=1
                ;;
            *)
                printf '%s\n' "unknown native muscle-bone visual option $1" >&2
                exit 2
                ;;
        esac
        shift 2
    done
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ -n "$frame_dimension" ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --muscle-step-seconds "$muscle_step_seconds" \
            --dimension "$frame_dimension"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --muscle-step-seconds "$muscle_step_seconds"
fi

# Focused route inspection is intentionally separate from the default anatomy
# capture. It exposes only selected source muscle centrelines, resolved through
# the MuJoCo tangent/wrap solver, around one requested MyoSim body. It projects
# authored source-site endpoints to the nearest registered BodyParts3D bone
# triangle only for the image, never for muscle force/path evaluation. This is
# a visual-registration diagnostic, not a tendon surface or medical certificate.
if [ "${1:-}" = "myosim-native-route-inspection" ]; then
    if [ "$#" -lt 6 ]; then
        printf '%s\n' "usage: numi human myosim-native-route-inspection <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> <focus-body-index> <source-muscle-index>... [--muscle-step-seconds <1e-6..1e-3> --muscle-step-count <1..64> --muscle-activation <0..1>] [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    focus_body_index=$5
    shift 5
    muscle_indices=
    frame_dimension=
    muscle_step_seconds=
    muscle_step_count=
    muscle_activation=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dimension)
                if [ -n "$frame_dimension" ] || [ "$#" -lt 2 ]; then
                    printf '%s\n' "--dimension may be given only once and requires a value" >&2
                    exit 2
                fi
                frame_dimension=$2
                shift 2
                ;;
            --muscle-step-seconds)
                if [ -n "$muscle_step_seconds" ] || [ "$#" -lt 2 ]; then
                    printf '%s\n' "--muscle-step-seconds may be given only once and requires a value" >&2
                    exit 2
                fi
                muscle_step_seconds=$2
                shift 2
                ;;
            --muscle-step-count)
                if [ -n "$muscle_step_count" ] || [ "$#" -lt 2 ]; then
                    printf '%s\n' "--muscle-step-count may be given only once and requires a value" >&2
                    exit 2
                fi
                muscle_step_count=$2
                shift 2
                ;;
            --muscle-activation)
                if [ -n "$muscle_activation" ] || [ "$#" -lt 2 ]; then
                    printf '%s\n' "--muscle-activation may be given only once and requires a value" >&2
                    exit 2
                fi
                muscle_activation=$2
                shift 2
                ;;
            --*)
                printf '%s\n' "unknown native route-inspection option $1" >&2
                exit 2
                ;;
            *)
                muscle_indices="$muscle_indices $1"
                shift
                ;;
        esac
    done
    if [ -z "$muscle_indices" ]; then
        printf '%s\n' "myosim-native-route-inspection requires at least one source-muscle-index" >&2
        exit 2
    fi
    if { [ -n "$muscle_step_count" ] || [ -n "$muscle_activation" ]; } && [ -z "$muscle_step_seconds" ]; then
        printf '%s\n' "--muscle-step-count and --muscle-activation require --muscle-step-seconds" >&2
        exit 2
    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --surface-project-source-sites \
        --focus-body-index "$focus_body_index"
    if [ -n "$frame_dimension" ]; then
        set -- "$@" --dimension "$frame_dimension"
    fi
    if [ -n "$muscle_step_seconds" ]; then
        set -- "$@" --muscle-step-seconds "$muscle_step_seconds"
        if [ -n "$muscle_step_count" ]; then
            set -- "$@" --muscle-step-count "$muscle_step_count"
        fi
        if [ -n "$muscle_activation" ]; then
            set -- "$@" --muscle-activation "$muscle_activation"
        fi
        support_contact=$artifact_directory/myosim-fullbody-support-contact.nhcnt
        if [ -f "$support_contact" ]; then
            set -- "$@" --support-contact-payload "$support_contact"
        fi
    fi
    for muscle_index in $muscle_indices; do
        set -- "$@" --source-route-index "$muscle_index"
        if [ -n "$muscle_step_seconds" ]; then
            set -- "$@" --activated-source-muscle-index "$muscle_index"
        fi
    done
    exec "$@"
fi

# Whole-body source-anatomy capture. Unlike the focused soft-tissue command
# below, this does not select one link: Core frames the native cameras from
# the exact rendered BodyParts3D geometry bounds so head, hands, and feet are
# present in every review angle. No Python runtime is started.
if [ "${1:-}" = "myosim-native-fullbody-soft-tissue-visuals" ]; then
    if [ "$#" -ne 5 ] && { [ "$#" -ne 7 ] || [ "$6" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-fullbody-soft-tissue-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 7 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --soft-tissue-payload "$soft_tissue_payload" \
            --dimension "$7"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload"
fi

# Exact BodyParts3D posterior-calf muscle/tendon surfaces use their fitted
# source-default local poses and two named articulated body frames.  This is
# native kinematic rendering only: it does not pretend a two-body surface bind
# is deformable muscle or tendon mechanics.
if [ "${1:-}" = "myosim-native-soft-tissue-visuals" ]; then
    if [ "$#" -ne 6 ] && { [ "$#" -ne 8 ] || [ "$7" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-soft-tissue-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> <focus-body-index> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
