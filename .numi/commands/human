    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload" \
        --visible-bone-body-index 20 \
        --visible-bone-body-index 29 \
        --visible-bone-body-index 34 \
        --visible-bone-body-index 41 \
        --visible-bone-body-index 42 \
        --visible-bone-body-index 43 \
        --soft-tissue-stable-id 69 \
        --soft-tissue-stable-id 71 \
        --soft-tissue-stable-id 73 \
        --soft-tissue-stable-id 75 \
        --soft-tissue-stable-id 77 \
        --soft-tissue-stable-id 79 \
        --soft-tissue-stable-id 81 \
        --soft-tissue-stable-id 83 \
        --soft-tissue-stable-id 85 \
        --soft-tissue-stable-id 87 \
        --soft-tissue-stable-id 89 \
        --soft-tissue-stable-id 91 \
        --soft-tissue-stable-id 93 \
        --soft-tissue-stable-id 95 \
        --soft-tissue-stable-id 97 \
        --soft-tissue-stable-id 99 \
        --soft-tissue-stable-id 101 \
        --soft-tissue-stable-id 103 \
        --soft-tissue-stable-id 105 \
        --soft-tissue-stable-id 107 \
        --soft-tissue-stable-id 109 \
        --focus-body-index 41
    if [ -n "$muscle_step_seconds" ]; then
