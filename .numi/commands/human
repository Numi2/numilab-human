#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Build NumiLab Human source artifacts and run native full-body muscle and articulated-visual references.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)

# The production-facing source-complete full-body reference never starts a
# Python process.  Python remains only in the offline upstream import adapter
# below, where MyoSim itself owns model composition.  Keeping this command
# native prevents the source convenience layer becoming a Numi runtime.
if [ "${1:-}" = "myosim-native-probe" ]; then
    if [ "$#" -ne 2 ] && [ "$#" -ne 3 ]; then
        printf '%s\n' "usage: numi human myosim-native-probe <artifact-directory> [--metal]" >&2
        exit 2
    fi
    if [ "$#" -eq 3 ] && [ "$3" != "--metal" ]; then
        printf '%s\n' "usage: numi human myosim-native-probe <artifact-directory> [--metal]" >&2
        exit 2
    fi
    artifact_directory=$2
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_reference_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_reference_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 3 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            --metal
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo"
fi

# This capture has the same no-Python runtime boundary as the full-body
# reference probe.  The source-default pose comes from the Metal articulated
# operator; Core's visual renderer then binds inertial-body proxies and the
# compiled MyoSim route-centerline evidence to that pose.
if [ "${1:-}" = "myosim-native-visuals" ]; then
    if [ "$#" -ne 3 ]; then
        printf '%s\n' "usage: numi human myosim-native-visuals <artifact-directory> <output-directory>" >&2
        exit 2
    fi
    artifact_directory=$2
    output_directory=$3
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$output_directory"
fi

# The source-prepared .nhbones package is consumed only by the native C++/Metal
# capture path.  It binds exact BodyParts3D visual-skeleton triangles to the current
# Metal articulated-body pose; Python is not started for this command.
if [ "${1:-}" = "myosim-native-bone-visuals" ]; then
    if [ "$#" -ne 4 ] && { [ "$#" -ne 6 ] || [ "$5" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-bone-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 6 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --dimension "$6"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory"
fi

# This is intentionally a bounded sensitivity capture rather than a simulation
# loop: the complete source muscle set is projected in Core FP64, compared
# against the matched passive free-body step, then the resulting one-step q is
# posed and rendered by the native Metal path.  Python is never started.
if [ "${1:-}" = "myosim-native-muscle-bone-visuals" ]; then
    if [ "$#" -lt 4 ] || [ $(( ($# - 4) % 2 )) -ne 0 ]; then
        printf '%s\n' "usage: numi human myosim-native-muscle-bone-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> [--muscle-step-seconds <1e-6..1e-3>] [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    shift 4
    muscle_step_seconds=0.001
    frame_dimension=
    saw_muscle_step=0
    saw_dimension=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --muscle-step-seconds)
                if [ "$saw_muscle_step" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-seconds may be given only once" >&2
                    exit 2
                fi
                muscle_step_seconds=$2
                saw_muscle_step=1
                ;;
            --dimension)
                if [ "$saw_dimension" -ne 0 ]; then
                    printf '%s\n' "--dimension may be given only once" >&2
                    exit 2
                fi
                frame_dimension=$2
                saw_dimension=1
                ;;
            *)
                printf '%s\n' "unknown native muscle-bone visual option $1" >&2
                exit 2
                ;;
        esac
        shift 2
    done
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ -n "$frame_dimension" ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --muscle-step-seconds "$muscle_step_seconds" \
            --dimension "$frame_dimension"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --muscle-step-seconds "$muscle_step_seconds"
fi

# Focused route inspection is intentionally separate from the default anatomy
# capture. It exposes only selected source muscle centrelines, resolved through
# the MuJoCo tangent/wrap solver, around one requested MyoSim body. It projects
# authored source-site endpoints to the nearest registered BodyParts3D bone
# triangle only for the image, never for muscle force/path evaluation. This is
# a visual-registration diagnostic, not a tendon surface or medical certificate.
if [ "${1:-}" = "myosim-native-route-inspection" ]; then
    if [ "$#" -lt 6 ]; then
        printf '%s\n' "usage: numi human myosim-native-route-inspection <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <output-directory> <focus-body-index> <source-muscle-index>... [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    output_directory=$4
    focus_body_index=$5
    shift 5
    muscle_indices=
    frame_dimension=
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --dimension)
                if [ -n "$frame_dimension" ] || [ "$#" -lt 2 ]; then
                    printf '%s\n' "--dimension may be given only once and requires a value" >&2
                    exit 2
                fi
                frame_dimension=$2
                shift 2
                ;;
            --*)
                printf '%s\n' "unknown native route-inspection option $1" >&2
                exit 2
                ;;
            *)
                muscle_indices="$muscle_indices $1"
                shift
                ;;
        esac
    done
    if [ -z "$muscle_indices" ]; then
        printf '%s\n' "myosim-native-route-inspection requires at least one source-muscle-index" >&2
        exit 2
    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --surface-project-source-sites \
        --focus-body-index "$focus_body_index"
    if [ -n "$frame_dimension" ]; then
        set -- "$@" --dimension "$frame_dimension"
    fi
    for muscle_index in $muscle_indices; do
        set -- "$@" --source-route-index "$muscle_index"
    done
    exec "$@"
fi

# Whole-body source-anatomy capture. Unlike the focused soft-tissue command
# below, this does not select one link: Core frames the native cameras from
# the exact rendered BodyParts3D geometry bounds so head, hands, and feet are
# present in every review angle. No Python runtime is started.
if [ "${1:-}" = "myosim-native-fullbody-soft-tissue-visuals" ]; then
    if [ "$#" -ne 5 ] && { [ "$#" -ne 7 ] || [ "$6" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-fullbody-soft-tissue-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 7 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --soft-tissue-payload "$soft_tissue_payload" \
            --dimension "$7"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload"
fi

# Exact BodyParts3D posterior-calf muscle/tendon surfaces use their fitted
# source-default local poses and two named articulated body frames.  This is
# native kinematic rendering only: it does not pretend a two-body surface bind
# is deformable muscle or tendon mechanics.
if [ "${1:-}" = "myosim-native-soft-tissue-visuals" ]; then
    if [ "$#" -ne 6 ] && { [ "$#" -ne 8 ] || [ "$7" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-soft-tissue-visuals <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> <focus-body-index> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    focus_body_index=$6
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    if [ "$#" -eq 8 ]; then
        exec "$probe" \
            "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
            "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
            "$bone_payload" \
            "$output_directory" \
            --soft-tissue-payload "$soft_tissue_payload" \
            --focus-body-index "$focus_body_index" \
            --dimension "$8"
    fi
    exec "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload" \
        --focus-body-index "$focus_body_index"
fi

# A compact four-angle posterior-chain inspection.  Stable IDs are authored
# into the versioned full-body surface map in this order: right lateral and
# medial gastrocnemius (1, 3), right soleus (5), and right calcaneal tendon
# (7).  Keeping this as a native filter avoids the broad 150-surface anatomy
# layer obscuring the actual tendon/calcaneus junction.  This is still a
# visual two-body surface bind, not a claim of tendon mechanics.
if [ "${1:-}" = "myosim-native-posterior-tendon-inspection" ]; then
    if [ "$#" -ne 5 ] && { [ "$#" -ne 7 ] || [ "$6" != "--dimension" ]; }; then
        printf '%s\n' "usage: numi human myosim-native-posterior-tendon-inspection <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    frame_dimension=
    if [ "$#" -eq 7 ]; then
        frame_dimension=$7
    fi
    runtime_root=${NUMI_LAB_ROOT:-/Users/home/Documents/emergentnumilife/MetalRobo}
    build_directory=${NUMI_BUILD_DIR:-$runtime_root/build}
    probe=$build_directory/bin/metalrobo_numilab_human_myosim_visual_probe
    if [ ! -x "$probe" ]; then
        printf '%s\n' "native Human visual probe is unavailable: $probe" >&2
        printf '%s\n' "build target metalrobo_numilab_human_myosim_visual_probe in $runtime_root" >&2
        exit 2
    fi
    set -- "$probe" \
        "$artifact_directory/myosim-fullbody-core-reference.nhrigid" \
        "$artifact_directory/myosim-fullbody-muscle-reference.nhmyo" \
        "$bone_payload" \
        "$output_directory" \
        --soft-tissue-payload "$soft_tissue_payload" \
        --visible-bone-body-index 131 \
        --visible-bone-body-index 136 \
        --visible-bone-body-index 137 \
        --visible-bone-body-index 138 \
        --visible-bone-body-index 139 \
        --visible-bone-body-index 142 \
        --soft-tissue-stable-id 1 \
        --soft-tissue-stable-id 3 \
        --soft-tissue-stable-id 5 \
        --soft-tissue-stable-id 7 \
        --focus-body-index 136
    if [ -n "$frame_dimension" ]; then
        set -- "$@" --dimension "$frame_dimension"
    fi
    exec "$@"
fi

# Native right upper-limb inspection. The selected BodyParts3D source surfaces
# are the shoulder stabilizers, deltoid, biceps, triceps, brachialis, and
# brachioradialis that span MyoSim's torso/scapula/humerus/forearm chain. The
# optional bounded update still evaluates all 416 MyoSim muscle paths; filtering
# affects only the anatomy presentation, never the actuation set.
if [ "${1:-}" = "myosim-native-upper-limb-inspection" ]; then
    if [ "$#" -lt 5 ] || [ $(( ($# - 5) % 2 )) -ne 0 ]; then
        printf '%s\n' "usage: numi human myosim-native-upper-limb-inspection <artifact-directory> <bodyparts3d-myosim-major-bones.nhbones> <bodyparts3d-myosim-soft-tissue.nhtissue> <output-directory> [--muscle-step-seconds <1e-6..1e-3>] [--muscle-step-count <1..64>] [--muscle-activation <0..1>] [--dimension <512..2048; multiple-of-64>]" >&2
        exit 2
    fi
    artifact_directory=$2
    bone_payload=$3
    soft_tissue_payload=$4
    output_directory=$5
    shift 5
    muscle_step_seconds=
    muscle_step_count=1
    muscle_activation=
    frame_dimension=
    saw_muscle_step=0
    saw_muscle_step_count=0
    saw_muscle_activation=0
    saw_dimension=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --muscle-step-seconds)
                if [ "$saw_muscle_step" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-seconds may be given only once" >&2
                    exit 2
                fi
                muscle_step_seconds=$2
                saw_muscle_step=1
                ;;
            --muscle-step-count)
                if [ "$saw_muscle_step_count" -ne 0 ]; then
                    printf '%s\n' "--muscle-step-count may be given only once" >&2
                    exit 2
                fi
                muscle_step_count=$2
                saw_muscle_step_count=1
                ;;
            --muscle-activation)
                if [ "$saw_muscle_activation" -ne 0 ]; then
                    printf '%s\n' "--muscle-activation may be given only once" >&2
                    exit 2
                fi
                muscle_activation=$2
                saw_muscle_activation=1
                ;;
            --dimension)
                if [ "$saw_dimension" -ne 0 ]; then
                    printf '%s\n' "--dimension may be given only once" >&2
                    exit 2
                fi
                frame_dimension=$2
                saw_dimension=1
                ;;
