#!/bin/sh
set -eu
repo=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
export PYTHONPATH="$repo/src${PYTHONPATH:+:$PYTHONPATH}"
if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Join one-adult-male organ, blood, tissue, fat, muscle, and subject runtime evidence while retaining zero physical owners and fail-closed calibration boundaries.'
    exit 0
fi
exec python3 -m numilab_human.body_composition_release_join "$@"
