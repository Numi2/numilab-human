#!/bin/sh
set -eu
if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Import the pinned CT-derived four-chamber wall mesh, source fibre fields and numerical-cap boundaries; offline source asset, no physical stepping.'
    exit 0
fi
command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
export PYTHONPATH="$repository_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.cardiac_wall_source "$@"
