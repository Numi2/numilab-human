#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Patch the published NHRIGID2 mass/inertia fields for the subject candidate while preserving source identity and topology.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
export PYTHONPATH="$repository_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.subject_scaled_runtime_input "$@"
