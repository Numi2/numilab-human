#!/bin/sh
set -eu

if [ "${1:-}" = "--numi-describe" ]; then
    printf '%s\n' 'Evaluate one source-bound adult-male AddBiomechanics subject with disjoint calibration/held-out residuals at the canonical 12.5 us prediction clock; never promote mechanics or behavior qualification.'
    exit 0
fi

command_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P)
repository_root=$(CDPATH= cd -- "$command_directory/../.." && pwd -P)
export PYTHONPATH="$repository_root/src${PYTHONPATH:+:$PYTHONPATH}"
exec "${NUMI_HUMAN_PYTHON:-python3}" -m numilab_human.addbiomechanics_validation "$@"
