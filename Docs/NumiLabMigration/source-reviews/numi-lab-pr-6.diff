+inline void femAdvancePosition(thread NMFEMNodeStateGPU& next,
+                               const NMFEMNodeStateGPU accepted,
+                               const float3 delta, const bool precise) {
+    if (!precise) {
+        next.positionAndMass.xyz = accepted.positionAndMass.xyz + delta;
