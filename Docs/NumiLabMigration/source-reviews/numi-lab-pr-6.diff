+             <<" virtual_work_checks=96 max_relative_error="<<worstVirtualWork<<"\n";
+    if(!cpu)gpu(inputs,directions);
+    return 0;
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;} } }
