+inline float3 femPreciseEdge(const NMFEMNodeStateGPU end,
+                             const NMFEMNodeStateGPU start) {
+    // Subtract the nearby high parts before adding their low residuals. A
+    // direct high+low world position would round away the low part again.
+    return (end.positionAndMass.xyz - start.positionAndMass.xyz) +
+           (end.positionLow.xyz - start.positionLow.xyz);
