+// A closed cavity has a cubic signed volume. All evaluations use one fixed
+// accepted vertex as origin, avoiding translation-dependent cancellation.
+inline float2 vascularCavityVolume(const NMVascularCavityGPU cavity,
+    device const NMVascularCavityFaceGPU* faces,
+    device const NMFEMNodeStateGPU* accepted,
+    device const NMFEMNodeStateGPU* candidate,
+    device const float4* direction, uint nodeBase, float dt,
+    bool derivative, float trialAlpha) {
+    const float3 origin = accepted[nodeBase + faces[cavity.faces.x].nodes.x].positionAndMass.xyz;
+    float2 sum = float2(0.0f), compensation = float2(0.0f);
+    for (uint slot = 0u; slot < cavity.faces.y; ++slot) {
+        const uint3 n = faces[cavity.faces.x + slot].nodes.xyz + nodeBase;
+        float3 a = candidate[n.x].positionAndMass.xyz - origin;
+        float3 b = candidate[n.y].positionAndMass.xyz - origin;
+        float3 c = candidate[n.z].positionAndMass.xyz - origin;
+        const bool needsDirection = derivative || trialAlpha != 0.0f;
+        const float3 da = needsDirection ? dt * direction[n.x].xyz : float3(0.0f);
+        const float3 db = needsDirection ? dt * direction[n.y].xyz : float3(0.0f);
+        const float3 dc = needsDirection ? dt * direction[n.z].xyz : float3(0.0f);
+        a += trialAlpha * da; b += trialAlpha * db; c += trialAlpha * dc;
+        const float v = dot(a, cross(b, c)) / 6.0f;
+        const float dv = derivative ?
+            (dot(da, cross(b, c)) + dot(a, cross(db, c) + cross(b, dc))) / 6.0f : 0.0f;
+        const float2 y = float2(v, dv) - compensation;
+        const float2 next = sum + y;
+        compensation = (next - sum) - y;
+        sum = next;
+    }
+    return sum.x > 0.0f && all(isfinite(sum)) ? sum : float2(INFINITY);
+}
+
+inline float3 vascularCavityGradient(float3 b, float3 c) { return cross(b, c) / 6.0f; }
+inline float3 vascularCavityGradientDirection(float3 b, float3 c, float3 db, float3 dc) {
+    return (cross(db, c) + cross(b, dc)) / 6.0f;
+}
+// Cyclically rotate the face so its differentiated node is first.
+inline uint3 vascularCavityRotate(uint3 n, uint node) {
+    return n.x == node ? n : (n.y == node ? n.yzx : n.zxy);
+}
+inline float3 vascularCavityNodeForce(uint node, uint nodeBase, uint stateBase,
+    const NMVascularLayoutGPU graph, float dt, bool derivative,
+    device const NMVascularUnknownGPU* unknowns,
+    device const NMVascularCompartmentGPU* compartments,
+    device const NMVascularCavityGPU* cavities,
+    device const NMVascularCavityFaceGPU* faces,
+    device const uint* incidence, device const NMVascularRangeGPU* ranges,
+    device const NMFEMNodeStateGPU* accepted, device const NMFEMNodeStateGPU* candidate,
+    device const float4* vascularState, device const float4* direction, uint directionBase) {
+    float3 result = float3(0.0f);
+    const NMVascularRangeGPU range = ranges[node];
+    for (uint slot = 0u; slot < range.count; ++slot) {
+        const NMVascularCavityFaceGPU face = faces[incidence[range.first + slot]];
+        const NMVascularCavityGPU cavity = cavities[face.identity.x];
+        const uint3 n = vascularCavityRotate(face.nodes.xyz, node) + nodeBase;
+        const float3 origin = accepted[nodeBase + faces[cavity.faces.x].nodes.x].positionAndMass.xyz;
+        const float3 b0 = accepted[n.y].positionAndMass.xyz - origin;
+        const float3 c0 = accepted[n.z].positionAndMass.xyz - origin;
+        const float3 b1 = candidate[n.y].positionAndMass.xyz - origin;
+        const float3 c1 = candidate[n.z].positionAndMass.xyz - origin;
+        const float3 bm = 0.5f * (b0 + b1), cm = 0.5f * (c0 + c1);
+        const float3 g = (vascularCavityGradient(b0, c0) +
+            4.0f * vascularCavityGradient(bm, cm) + vascularCavityGradient(b1, c1)) / 6.0f;
+        const uint row = cavity.identity.w;
+        const float p = vascularPhysical(vascularState, unknowns, stateBase, row) -
+            compartments[cavity.identity.y].compliance.w;
+        if (derivative) {
+            const float3 db = dt * direction[n.y].xyz, dc = dt * direction[n.z].xyz;
+            const float3 dg = (2.0f * vascularCavityGradientDirection(bm, cm, db, dc) +
+                vascularCavityGradientDirection(b1, c1, db, dc)) / 6.0f;
+            const float dp = direction[directionBase + row].x * unknowns[row].initialAndScaling.y;
+            result += dp * g + p * dg;
+        } else result += p * g;
+    }
+    return result;
+}
+
+kernel void nm_vascular_cavity_forces(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMVascularLayoutGPU& graph [[buffer(1)]],
+    constant NMMicrostepGPU& microstep [[buffer(2)]],
+    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
+    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
+    device const NMVascularCavityGPU* cavities [[buffer(5)]],
+    device const NMVascularCavityFaceGPU* faces [[buffer(6)]],
+    device const uint* incidence [[buffer(7)]],
+    device const NMVascularRangeGPU* ranges [[buffer(8)]],
+    device const NMFEMNodeStateGPU* accepted [[buffer(9)]],
+    device const NMFEMNodeStateGPU* candidate [[buffer(10)]],
+    device const float4* vascularState [[buffer(11)]],
+    device const float4* borrowed [[buffer(12)]],
+    constant uint& hasBorrowed [[buffer(13)]],
+    device float4* merged [[buffer(14)]],
+    device NMMatterStatusGPU* statuses [[buffer(15)]],
+    uint global [[thread_position_in_grid]]) {
+    if (global >= dispatch.environmentCount * dispatch.femNodeCount) return;
+    const uint environment = global / dispatch.femNodeCount;
+    const uint nodeBase = environment * dispatch.femNodeCount;
+    float3 force = hasBorrowed != 0u ? borrowed[global].xyz : float3(0.0f);
+    if (environmentHealthy(statuses, environment))
+        force += vascularCavityNodeForce(global - nodeBase, nodeBase, environment * graph.ranges.z,
+            graph, microstep.time.x, false, unknowns, compartments, cavities, faces, incidence, ranges,
+            accepted, candidate, vascularState, vascularState, 0u);
+    merged[global] = float4(force, 0.0f);
+    if (!all(isfinite(force))) recordFailure(statuses[environment], NM_STATUS_NONLINEAR_SOLVER_FAILURE,
+        NM_INVALID_INDEX, global - nodeBase, float4(force, 0.0f));
+}
+kernel void nm_vascular_cavity_operator(
+    constant NMMatterDispatchGPU& dispatch [[buffer(0)]],
+    constant NMVascularLayoutGPU& graph [[buffer(1)]],
+    constant NMMicrostepGPU& microstep [[buffer(2)]],
+    device const NMVascularUnknownGPU* unknowns [[buffer(3)]],
+    device const NMVascularCompartmentGPU* compartments [[buffer(4)]],
+    device const NMVascularCavityGPU* cavities [[buffer(5)]],
+    device const NMVascularCavityFaceGPU* faces [[buffer(6)]],
+    device const uint* incidence [[buffer(7)]],
+    device const NMVascularRangeGPU* ranges [[buffer(8)]],
+    device const NMFEMNodeStateGPU* accepted [[buffer(9)]],
