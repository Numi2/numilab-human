+// Return absolute pressure and its physical directional derivative. A
+// deforming cavity has an independent pressure row, never lumped compliance.
+inline float2 vascularNodePressure(uint nodeIndex, uint stateBase, uint coefficientBase,
+    uint directionBase, bool derivative, float trialAlpha,
+    device const NMVascularUnknownGPU* unknowns,
+    device const NMVascularCompartmentGPU* compartments,
+    device const NMVascularCavityGPU* cavities, device const uint* compartmentCavity,
+    device const float4* candidate, device const float4* direction,
+    device const float* elastance) {
+    const bool cavity = compartments[nodeIndex].identity.w == 5u;
+    const uint row = cavity ? cavities[compartmentCavity[nodeIndex]].identity.w : nodeIndex;
+    const float dv = derivative || trialAlpha != 0.0f ?
+        direction[directionBase + row].x * unknowns[row].initialAndScaling.y : 0.0f;
+    const float value = vascularPhysical(candidate, unknowns, stateBase, row) + trialAlpha * dv;
+    if (cavity) return float2(value, derivative ? dv : 0.0f);
+    const float2 pressure = vascularPressureTangent(compartments[nodeIndex], value, elastance[coefficientBase + nodeIndex]);
+    return float2(pressure.x, derivative ? pressure.y * dv : 0.0f);
+}
